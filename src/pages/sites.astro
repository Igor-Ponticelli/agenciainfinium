---
import Base from '../layouts/Base.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Linha from '../components/Linha.astro';
import FontesPrevias from '../components/FontesPrevias.astro';
import Obra from '../components/Obra.astro';
import { todosProjetos } from '../data/projetos';
import { linkWhatsapp } from '../data/empresa';
import { rotas } from '../i18n/rotas';
import { sites as t } from '../i18n/paginas/sites';
import { metasPaginas } from '../i18n/textos';

/** Página de sites: a planilha do serviço, aberta na primeira linha (brief da página de serviço). */
const meta = metasPaginas.sites;
const projetos = (await todosProjetos()).filter((p) => p.data.tipo === 'site');
const formato = (i: number) => (i % 4 === 0 ? 'grande' : 'media');
const ficha = (i: number) => (i % 4 === 0 ? 'lado' : 'abaixo');
const site = Astro.site!;
const jsonLd = {
  '@type': 'Service',
  '@id': new URL(rotas.sites, site).href + '#servico',
  name: 'Criação de sites',
  serviceType: 'Criação de sites institucionais, landing pages e páginas de venda',
  description: meta.descricao,
  url: new URL(rotas.sites, site).href,
  provider: { '@id': `${site.origin}/#organizacao` },
  areaServed: 'BR',
};
---

<Base titulo={meta.titulo} descricao={meta.descricao} jsonLd={[jsonLd]}>
  <FontesPrevias slot="head" />
  <section class="folha pagina-cabeca" aria-labelledby="pagina-titulo">
    <Linha>
      <h1 class="pagina-titulo" id="pagina-titulo">
        {t.titulo}
      </h1>
    </Linha>
    <Linha class="linha-selecionada">
      <p class="pagina-frase">{t.frase}</p>
    </Linha>
    <Linha>
      <p class="pagina-texto">{t.texto}</p>
    </Linha>
    <Linha>
      <div class="pagina-acao acoes">
        <a
          class="botao"
          href={linkWhatsapp('site')}
          target="_blank"
          rel="noopener"
          data-evento="whatsapp_sites_topo"
        >
          {t.acao}
          <span class="visualmente-oculto">(abre em nova aba)</span>
        </a>
      </div>
    </Linha>
  </section>

  <section class="folha" aria-labelledby="problema-titulo">
    <Linha>
      <h2 class="titulo-secao" id="problema-titulo">
        {t.problema.titulo}
      </h2>
    </Linha>
    <Linha class="linha-texto">
      <div class="texto">
        <p>{t.problema.texto}</p>
      </div>
    </Linha>
  </section>

  <section class="folha" aria-labelledby="tipos-titulo">
    <Linha>
      <h2 class="titulo-secao" id="tipos-titulo">
        {t.tipos.titulo}
      </h2>
    </Linha>
    {t.tipos.itens.map((i) => (
      <Linha>
        <h3 class="par-chave">{i.titulo}</h3>
        <p class="par-valor">{i.texto}</p>
      </Linha>
    ))}
  </section>

  <section class="folha" aria-labelledby="inclui-titulo">
    <Linha>
      <h2 class="titulo-secao" id="inclui-titulo">
        {t.inclui.titulo}
      </h2>
    </Linha>
    <ul class="lista-planilha">
      {t.inclui.itens.map((i) => (
        <Linha as="li">
          <span class="item-linha">{i}</span>
        </Linha>
      ))}
    </ul>
  </section>

  <section class="folha" aria-labelledby="como-titulo">
    <Linha>
      <h2 class="titulo-secao" id="como-titulo">
        {t.comoFunciona.titulo}
      </h2>
    </Linha>
    <ol class="passos" data-laco>
      {t.comoFunciona.passos.map((p) => (
        <Linha as="li" class="passo">
          <span class="passo-indice" aria-hidden="true"></span>
          <h3 class="passo-titulo">{p.titulo}</h3>
          <p class="passo-texto">{p.texto}</p>
        </Linha>
      ))}
    </ol>
  </section>

  <section class="folha vitrines" aria-labelledby="prova-titulo">
    <Linha class="vitrines-cabeca">
      <h2 class="titulo-secao" id="prova-titulo">
        {t.prova.titulo}
      </h2>
      <p class="celula celula-apoio">{t.prova.texto}</p>
    </Linha>
    <div class="vitrines-grade">
      {projetos.map((p, i) => (
        <Obra projeto={p} formato={formato(i)} ficha={ficha(i)} />
      ))}
    </div>
  </section>

  <section class="folha" aria-labelledby="faq-titulo">
    <Linha>
      <h2 class="titulo-secao" id="faq-titulo">
        {t.faq.titulo}
      </h2>
    </Linha>
    {t.faq.itens.map((i) => (
      <Linha>
        <details class="faq-item">
          <summary>{i.pergunta}</summary>
          <p>{i.resposta}</p>
        </details>
      </Linha>
    ))}
  </section>

  <ChamadaFinal
    slot="fechamento"
    titulo={t.chamada.titulo}
    texto={t.chamada.texto}
    acao={t.chamada.acao}
    href={linkWhatsapp('site')}
    evento="whatsapp_chamada_final"
    secundaria={{ rotulo: t.chamada.formulario, href: rotas.contato }}
  />
</Base>
