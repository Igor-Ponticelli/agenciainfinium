---
import simbolo from '../assets/marca/simbolo-white.svg?raw';
import Base from '../layouts/Base.astro';
import Dupla from '../components/Dupla.astro';
import Faq from '../components/Faq.astro';
import FontesPrevias from '../components/FontesPrevias.astro';
import Foto from '../components/Foto.astro';
import Galeria from '../components/Galeria.astro';
import Icone from '../components/Icone.astro';
import Passos from '../components/Passos.astro';
import Rolante from '../components/Rolante.astro';
import Secao from '../components/Secao.astro';
import Topicos from '../components/Topicos.astro';
import { dataCurta, dataDoPost, dataIso, postsPublicados } from '../data/blog';
import { linkWhatsapp } from '../data/empresa';
import { todosProjetos } from '../data/projetos';
import { blog as tb } from '../i18n/paginas/blog';
import { inicio as t } from '../i18n/paginas/inicio';
import { rotaPost, rotas } from '../i18n/rotas';
import { metasPaginas, textos } from '../i18n/textos';

/**
 * Home, direção "o infinito" (05/11/2026): a frase gigante sobre a foto em luz violeta (a
 * abertura D, escolhida pelo Igor), a faixa
 * rolante, a cena em tópicos com ícone, os dois serviços com imagem de um lado e texto do outro,
 * a conexão com o símbolo, a galeria de projetos, as etapas com a cabeça fixa, o que muda, o
 * blog, as perguntas e a chamada final gigante. Uma frase por tópico, cada tópico com o seu ícone.
 */
const meta = metasPaginas.inicio;
const projetos = await todosProjetos();
const posts = (await postsPublicados()).slice(0, 3);
// O símbolo com pathLength, para a fita se desenhar (site.css)
const laco = simbolo.replace('<path ', '<path pathLength="1" ');
const seta =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const setaBaixo =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>';
const setaGrande =
  '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<Base titulo={meta.titulo} descricao={meta.descricao} tituloCompleto>
  <FontesPrevias slot="head" />

  <Secao class="abertura" cheia aria-labelledby="abertura-titulo">
    <Foto
      class="abertura-foto"
      nome="notebook"
      tom="violeta"
      prioridade
      posicao="50% 40%"
      sizes="100vw"
      widths={[800, 1200, 1600, 2000]}
    />
    <div class="miolo abertura-grade">
      <h1 id="abertura-titulo">{t.abertura.titulo}</h1>
      <div class="abertura-apoio">
        <p>{t.abertura.texto}</p>
        <div class="acoes">
          <a
            class="botao"
            href={linkWhatsapp()}
            target="_blank"
            rel="noopener"
            data-evento="whatsapp_abertura"
          >
            {t.abertura.acaoPrincipal}
            <span class="visualmente-oculto">{textos.linkExterno}</span>
          </a>
          <a class="link-fita" href={`#${t.abertura.ancoraProjetos}`}>
            {t.abertura.acaoSecundaria}
            <Fragment set:html={setaBaixo} />
          </a>
        </div>
      </div>
    </div>
    <Rolante itens={t.faixa} />
  </Secao>

  <Secao class="cena" aria-labelledby="cena-titulo">
    <div class="cabeca-secao">
      <h2 id="cena-titulo">{t.problema.titulo}</h2>
    </div>
    <div class="cena-grade">
      <Topicos itens={t.problema.itens} class="topicos-4 revelar" />
      <div class="cena-resultado revelar">
        <p class="cena-frase">{t.problema.frase}</p>
        <span class="cena-seta" set:html={setaGrande} aria-hidden="true" />
        <div class="topico">
          <Icone nome={t.problema.resultado.icone} tamanho={30} />
          <div class="topico-texto">
            <h3>{t.problema.resultado.titulo}</h3>
            <p>{t.problema.resultado.texto}</p>
          </div>
        </div>
      </div>
    </div>
  </Secao>

  <Secao tom="claro" aria-labelledby="servicos-titulo">
    <div class="cabeca-secao">
      <h2 id="servicos-titulo">{t.servicos.titulo}</h2>
    </div>
    <Dupla foto="entre" class="revelar">
      <h2>{t.servicos.sites.titulo}</h2>
      <p class="frase-chave">{t.servicos.sites.frase}</p>
      <p>{t.servicos.sites.texto}</p>
      <Topicos itens={t.servicos.sites.topicos} compactos />
      <div class="acoes">
        <a class="botao" href={rotas.sites} data-evento="servico_site">
          {t.servicos.sites.verServico}
        </a>
        <a
          class="link-fita"
          href={linkWhatsapp('site')}
          target="_blank"
          rel="noopener"
          data-evento="whatsapp_sites"
        >
          {t.servicos.sites.whatsapp}
          <Fragment set:html={seta} />
          <span class="visualmente-oculto">{textos.linkExterno}</span>
        </a>
      </div>
    </Dupla>
    <Dupla foto="estoque" invertida class="revelar">
      <h2>{t.servicos.sistemas.titulo}</h2>
      <p class="frase-chave">{t.servicos.sistemas.frase}</p>
      <p>{t.servicos.sistemas.texto}</p>
      <Topicos itens={t.servicos.sistemas.topicos} compactos />
      <div class="acoes">
        <a class="botao" href={rotas.sistemas} data-evento="servico_sistema">
          {t.servicos.sistemas.verServico}
        </a>
        <a
          class="link-fita"
          href={linkWhatsapp('sistema')}
          target="_blank"
          rel="noopener"
          data-evento="whatsapp_sistemas"
        >
          {t.servicos.sistemas.whatsapp}
          <Fragment set:html={seta} />
          <span class="visualmente-oculto">{textos.linkExterno}</span>
        </a>
      </div>
    </Dupla>
  </Secao>

  <Secao tom="degrade" miolo="conexao-grade revelar" aria-labelledby="conexao-titulo">
    <h2 id="conexao-titulo">
      <span class="conexao-antes">{t.conexao.antes}</span>
      <span class="conexao-simbolo" set:html={laco} aria-hidden="true" />
      <span class="conexao-depois">{t.conexao.depois}</span>
    </h2>
    <p>{t.conexao.texto}</p>
  </Secao>

  <Secao tom="profundo" cheia id={t.abertura.ancoraProjetos} aria-labelledby="projetos-titulo">
    <div class="miolo">
      <div class="cabeca-secao cabeca-secao-linha">
        <div>
          <h2 id="projetos-titulo">{t.projetos.titulo}</h2>
          <p>{t.projetos.texto}</p>
        </div>
        <a class="link-fita" href={rotas.projetos}>
          {t.projetos.acao}
          <Fragment set:html={seta} />
        </a>
      </div>
    </div>
    <Galeria projetos={projetos} anterior={t.projetos.anterior} proximo={t.projetos.proximo} />
  </Secao>

  <Secao id={t.abertura.ancoraComoFunciona} aria-labelledby="como-titulo">
    <Passos
      titulo={t.comoFunciona.titulo}
      texto={t.comoFunciona.texto}
      passos={t.comoFunciona.passos}
      idTitulo="como-titulo"
    />
  </Secao>

  <Secao tom="claro" aria-labelledby="resultados-titulo">
    <div class="cabeca-secao">
      <h2 id="resultados-titulo">{t.resultados.titulo}</h2>
    </div>
    <Topicos itens={t.resultados.itens} class="topicos-5 revelar" />
  </Secao>

  {posts.length > 0 && (
    <Secao tom="claro" class="faixa-junta" aria-labelledby="posts-titulo">
      <div class="cabeca-secao cabeca-secao-linha">
        <div>
          <h2 id="posts-titulo">{tb.rotulos.naHome}</h2>
        </div>
        <a class="link-fita" href={rotas.blog}>
          {tb.rotulos.verBlog}
          <Fragment set:html={seta} />
        </a>
      </div>
      <ul class="posts home-posts revelar">
        {posts.map((post) => {
          const data = dataDoPost(post);
          return (
            <li class="post-cartao">
              <Foto
                class="post-capa"
                nome={post.data.capa}
                widths={[480, 800]}
                sizes="(min-width: 48rem) 26rem, 100vw"
              />
              <div class="post-cartao-texto">
                <time datetime={dataIso(data)}>{dataCurta(data)}</time>
                <h3>
                  <a href={rotaPost(post.id)}>{post.data.titulo}</a>
                </h3>
              </div>
            </li>
          );
        })}
      </ul>
    </Secao>
  )}

  <Secao miolo="faq-grade" aria-labelledby="faq-titulo">
    <h2 id="faq-titulo">{t.faq.titulo}</h2>
    <Faq itens={t.faq.itens} class="revelar" />
  </Secao>
</Base>
