---
import Base from '../layouts/Base.astro';
import Cabeca from '../components/Cabeca.astro';
import Secao from '../components/Secao.astro';
import { privacidade as t } from '../i18n/paginas/privacidade';
import { metasPaginas } from '../i18n/textos';

/** Política de privacidade (LGPD): o que este site coleta de verdade, em português simples. */
const meta = metasPaginas.privacidade;
const atualizado = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Sao_Paulo',
}).format(new Date(`${t.atualizadoEm}T12:00:00-03:00`));
---

<Base titulo={meta.titulo} descricao={meta.descricao} semChamada>
  <Cabeca titulo={t.titulo} texto={t.texto}>
    <p class="cabeca-meta">
      <span>
        {t.rotuloAtualizado}: <time datetime={t.atualizadoEm}>{atualizado}</time>
      </span>
    </p>
  </Cabeca>

  <Secao tom="claro" aria-label={t.titulo}>
    <div class="texto-longo">
      {t.secoes.map((s) => (
        <>
          <h2>{s.titulo}</h2>
          {s.paragrafos.map((p) => (
            <p>{p}</p>
          ))}
        </>
      ))}
    </div>
  </Secao>
</Base>
