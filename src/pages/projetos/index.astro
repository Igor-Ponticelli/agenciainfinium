---
import Base from '../../layouts/Base.astro';
import { todosProjetos } from '../../data/projetos';
import { linkWhatsapp } from '../../data/empresa';
import { rotaProjeto } from '../../i18n/rotas';
import { projetos as t } from '../../i18n/paginas/projetos';
import { metasPaginas, tiposProjeto } from '../../i18n/textos';

const meta = metasPaginas.projetos;
const todos = await todosProjetos();
---

<Base titulo={meta.titulo} descricao={meta.descricao}>
  <h1>{t.titulo}</h1>
  <p>{t.texto}</p>

  {tiposProjeto.map((tipo) => (
    <section>
      <h2>{t.grupos[tipo].titulo}</h2>
      <p>{t.grupos[tipo].texto}</p>
      <ul>
        {todos
          .filter((p) => p.data.tipo === tipo)
          .map((p) => (
            <li>
              <a href={rotaProjeto(p.data.slug)}>{p.data.titulo}</a>: {p.data.resumo}
            </li>
          ))}
      </ul>
    </section>
  ))}

  <section>
    <h2>{t.chamada.titulo}</h2>
    <p>
      <a href={linkWhatsapp()}>{t.chamada.acao}</a>
    </p>
  </section>
</Base>
