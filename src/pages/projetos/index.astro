---
import Base from '../../layouts/Base.astro';
import Cabeca from '../../components/Cabeca.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';
import FontesPrevias from '../../components/FontesPrevias.astro';
import Secao from '../../components/Secao.astro';
import Vitrine from '../../components/Vitrine.astro';
import { todosProjetos } from '../../data/projetos';
import { projetos as t } from '../../i18n/paginas/projetos';
import { rotaProjeto } from '../../i18n/rotas';
import { metasPaginas, textos, tiposProjeto } from '../../i18n/textos';

/** Portfólio: os projetos em linhas largas, agrupados por tipo, alternando o lado da prévia. */
const meta = metasPaginas.projetos;
const todos = await todosProjetos();
const indice = (i: number) => String(i + 1).padStart(2, '0');
---

<Base titulo={meta.titulo} descricao={meta.descricao} semChamada>
  <FontesPrevias slot="head" />
  <Cabeca titulo={t.titulo} texto={t.texto} />

  {tiposProjeto.map((tipo, idx) => {
    const grupo = todos.filter((p) => p.data.tipo === tipo);
    const base = tiposProjeto
      .slice(0, idx)
      .reduce((n, tp) => n + todos.filter((p) => p.data.tipo === tp).length, 0);
    return (
      <Secao tom={idx % 2 === 0 ? 'claro' : 'profundo'} aria-labelledby={`grupo-${tipo}`}>
        <div class="cabeca-secao">
          <h2 id={`grupo-${tipo}`}>{t.grupos[tipo].titulo}</h2>
          <p>{t.grupos[tipo].texto}</p>
        </div>
        <ol class="obras">
          {grupo.map((p, i) => (
            <li class="obra revelar">
              <Vitrine projeto={p} moldura="navegador" proporcao="16 / 10" />
              <div class="obra-ficha">
                <span class="obra-indice" aria-hidden="true">
                  {indice(base + i)}
                </span>
                <h3>
                  <a href={rotaProjeto(p.data.slug)}>{p.data.titulo}</a>
                </h3>
                <p class="obra-tipo">
                  {textos.projeto.tipo[p.data.tipo]} · {p.data.ano} ·{' '}
                  {textos.projeto.status[p.data.status]}
                </p>
                <p>{p.data.resumo}</p>
                <a class="link-fita" href={rotaProjeto(p.data.slug)}>
                  {textos.acoes.verProjeto}
                  <span class="visualmente-oculto">: {p.data.titulo}</span>
                </a>
              </div>
            </li>
          ))}
        </ol>
      </Secao>
    );
  })}

  <ChamadaFinal slot="fechamento" titulo={t.chamada.titulo} acao={t.chamada.acao} />
</Base>
