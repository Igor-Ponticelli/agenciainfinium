---
import Base from '../layouts/Base.astro';
import Colunas from '../components/Colunas.astro';
import Linha from '../components/Linha.astro';
import { metasPaginas } from '../i18n/textos';

/** Política de privacidade: o texto entra no TODO 6, com GA4, Pixel e formulário definidos. */
const meta = metasPaginas.privacidade;
---

<Base titulo={meta.titulo} descricao={meta.descricao}>
  <section class="folha pagina-cabeca" aria-labelledby="pagina-titulo">
    <Colunas />
    <Linha>
      <h1 class="pagina-titulo" id="pagina-titulo">
        Política de privacidade
      </h1>
    </Linha>
    <Linha>
      <p class="pagina-texto">[PENDENTE: o texto da política entra no TODO 6]</p>
    </Linha>
  </section>
</Base>
