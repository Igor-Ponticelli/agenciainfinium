---
import { linkRaioX } from '../data/raioX';
import { raioX as t } from '../i18n/paginas/raioX';

/**
 * O botão da landing page do Raio-X: vai para o link de pagamento ou, enquanto ele não existe,
 * para o WhatsApp. `data-raio-x-pagamento` marca o link que recebe os parâmetros UTM (raio-x.ts).
 */
interface Props {
  evento: string;
  rotulo?: string;
}

const { evento, rotulo = t.abertura.acao } = Astro.props;
const destino = linkRaioX();
---

<a
  class:list={['botao', 'botao-grande']}
  href={destino.href}
  target="_blank"
  rel="noopener"
  data-evento={evento}
  data-raio-x-pagamento={destino.pagamento ? '' : undefined}
>
  {rotulo}
  <span class="visualmente-oculto">(abre em nova aba)</span>
</a>
