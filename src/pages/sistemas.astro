---
import Base from '../layouts/Base.astro';
import Cabeca from '../components/Cabeca.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Dupla from '../components/Dupla.astro';
import Faq from '../components/Faq.astro';
import FontesPrevias from '../components/FontesPrevias.astro';
import Passos from '../components/Passos.astro';
import Secao from '../components/Secao.astro';
import Topicos from '../components/Topicos.astro';
import Vitrine from '../components/Vitrine.astro';
import type { NomeIcone } from '../data/icones';
import { todosProjetos } from '../data/projetos';
import { linkWhatsapp } from '../data/empresa';
import { sistemas as t } from '../i18n/paginas/sistemas';
import { rotaProjeto, rotas } from '../i18n/rotas';
import { metasPaginas, textos } from '../i18n/textos';

/**
 * Página de sistemas: a cabeça com a foto, o problema em tópicos, "um sistema só" em dupla, a
 * tabela de antes e depois num cartão claro, o que muda, as etapas (com o diagnóstico em
 * repouso), o RetroDash como prova e as perguntas.
 */
const meta = metasPaginas.sistemas;
const produtos = (await todosProjetos()).filter((p) => p.data.tipo === 'produto');
const iconesProblema: NomeIcone[] = ['planilha', 'quadro', 'nota', 'balao'];
const iconesSolucao: NomeIcone[] = ['banco', 'ciclo', 'conexoes', 'painel'];
const iconesBeneficios: NomeIcone[] = ['relogio', 'certo', 'usuarios', 'olho', 'crescimento'];
const iconesPassos: NomeIcone[] = [
  'balao',
  'video',
  'lupa',
  'documento',
  'etiqueta',
  'quadro',
  'banco',
  'usuarios',
  'ciclo',
];
const problema = t.problema.itens.map((i, idx) => ({ icone: iconesProblema[idx]!, titulo: i }));
const solucao = t.solucao.itens.map((i, idx) => ({ icone: iconesSolucao[idx]!, ...i }));
const beneficios = t.beneficios.itens.map((i, idx) => ({ icone: iconesBeneficios[idx]!, ...i }));
const passos = t.comoFunciona.passos.map((p, idx) => ({ icone: iconesPassos[idx]!, ...p }));
const site = Astro.site!;
const jsonLd = {
  '@type': 'Service',
  '@id': new URL(rotas.sistemas, site).href + '#servico',
  name: 'Sistemas sob medida e automação de processos',
  serviceType: 'Desenvolvimento de sistemas sob medida e automação de processos',
  description: meta.descricao,
  url: new URL(rotas.sistemas, site).href,
  provider: { '@id': `${site.origin}/#organizacao` },
  areaServed: 'BR',
};
---

<Base titulo={meta.titulo} descricao={meta.descricao} jsonLd={[jsonLd]} semChamada>
  <FontesPrevias slot="head" />
  <Cabeca titulo={t.titulo} frase={t.frase} texto={t.texto} foto="postIts">
    <div class="acoes">
      <a
        class="botao"
        href={linkWhatsapp('sistema')}
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_sistemas_topo"
      >
        {t.acao}
        <span class="visualmente-oculto">{textos.linkExterno}</span>
      </a>
    </div>
  </Cabeca>

  <Secao tom="claro" aria-labelledby="problema-titulo">
    <div class="cabeca-secao">
      <h2 id="problema-titulo">{t.problema.titulo}</h2>
      <p>{t.problema.texto}</p>
    </div>
    <Topicos itens={problema} class="topicos-4 revelar" />
  </Secao>

  <Secao aria-labelledby="solucao-titulo">
    <Dupla foto="planilha" tom="violeta" invertida class="revelar">
      <h2 id="solucao-titulo">{t.solucao.titulo}</h2>
      <p>{t.solucao.texto}</p>
      <Topicos itens={solucao} compactos />
    </Dupla>
  </Secao>

  <Secao tom="degrade" aria-labelledby="antes-depois-titulo">
    <div class="cabeca-secao">
      <h2 id="antes-depois-titulo">{t.antesDepois.titulo}</h2>
    </div>
    <div class="antes-depois revelar">
      <table>
        <caption class="visualmente-oculto">{t.antesDepois.titulo}</caption>
        <thead>
          <tr>
            <th scope="col">{t.antesDepois.colunas.antes}</th>
            <th scope="col">{t.antesDepois.colunas.depois}</th>
          </tr>
        </thead>
        <tbody>
          {t.antesDepois.linhas.map((l) => (
            <tr>
              <td>{l.antes}</td>
              <td>{l.depois}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Secao>

  <Secao tom="claro" aria-labelledby="beneficios-titulo">
    <div class="cabeca-secao">
      <h2 id="beneficios-titulo">{t.beneficios.titulo}</h2>
    </div>
    <Topicos itens={beneficios} class="topicos-5 revelar" />
  </Secao>

  <Secao aria-labelledby="como-titulo">
    <Passos
      titulo={t.comoFunciona.titulo}
      texto={t.comoFunciona.texto}
      passos={passos}
      idTitulo="como-titulo"
      inicio={2}
    />
  </Secao>

  <Secao tom="profundo" aria-labelledby="prova-titulo">
    <div class="cabeca-secao">
      <h2 id="prova-titulo">{t.prova.titulo}</h2>
      <p>{t.prova.texto}</p>
    </div>
    <ol class="obras">
      {produtos.map((p) => (
        <li class="obra revelar">
          <Vitrine projeto={p} moldura="navegador" proporcao="16 / 10" />
          <div class="obra-ficha">
            <h3>
              <a href={rotaProjeto(p.data.slug)}>{p.data.titulo}</a>
            </h3>
            <p class="obra-tipo">
              {textos.projeto.tipo[p.data.tipo]} · {p.data.ano}
            </p>
            <p>{p.data.resumo}</p>
            <a class="link-fita" href={rotaProjeto(p.data.slug)}>
              {textos.acoes.verProjeto}
              <span class="visualmente-oculto">: {p.data.titulo}</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
    <p class="pendente apagado" style="margin-block-start: var(--space-l); max-inline-size: 48ch">
      {t.prova.solto}
    </p>
  </Secao>

  <Secao miolo="faq-grade" aria-labelledby="faq-titulo">
    <h2 id="faq-titulo">{t.faq.titulo}</h2>
    <Faq itens={t.faq.itens} class="revelar" />
  </Secao>

  <ChamadaFinal
    slot="fechamento"
    titulo={t.chamada.titulo}
    texto={t.chamada.texto}
    acao={t.chamada.acao}
    href={linkWhatsapp('sistema')}
    secundaria={{ rotulo: t.chamada.formulario, href: rotas.contato }}
  />
</Base>
