---
import { icones, type NomeIcone } from '../data/icones';

/**
 * Um ícone de traço, desenhado pela fita conforme a rolagem (site.css: `.icone`). Decorativo:
 * sempre acompanha um texto, por isso fica fora da árvore de acessibilidade. Com movimento
 * reduzido, sem suporte a animação por rolagem ou sem CSS novo, aparece desenhado.
 */
interface Props {
  nome: NomeIcone;
  tamanho?: number;
  class?: string;
}

const { nome, tamanho = 28, class: classe } = Astro.props;
---

<span class:list={['icone', classe]} aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    width={tamanho}
    height={tamanho}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icones[nome]}
  />
</span>
