---
import Base from '../../layouts/Base.astro';
import Cabeca from '../../components/Cabeca.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';
import Foto from '../../components/Foto.astro';
import Secao from '../../components/Secao.astro';
import { dataCurta, dataDoPost, dataIso, postsPublicados, tempoDeLeitura } from '../../data/blog';
import { rotaPost } from '../../i18n/rotas';
import { blog as t } from '../../i18n/paginas/blog';
import { metasPaginas } from '../../i18n/textos';

/** Blog: os posts em cartões com a capa, do mais novo para o mais antigo. */
const meta = metasPaginas.blog;
const posts = await postsPublicados();
const seta =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<Base titulo={meta.titulo} descricao={meta.descricao} semChamada>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="Blog da Infinium"
    href="/blog/rss.xml"
  />
  <Cabeca titulo={t.titulo} texto={t.texto} />

  <Secao tom="claro" aria-label={t.rotulos.todos}>
    <ul class="posts">
      {posts.map((post) => {
        const data = dataDoPost(post);
        return (
          <li class="post-cartao revelar">
            <Foto
              class="post-capa"
              nome={post.data.capa}
              widths={[480, 800]}
              sizes="(min-width: 48rem) 26rem, 100vw"
            />
            <div class="post-cartao-texto">
              <span class="post-pilula">
                <time datetime={dataIso(data)}>{dataCurta(data)}</time> ·{' '}
                {t.rotulos.leitura(tempoDeLeitura(post))}
              </span>
              <h2>
                <a href={rotaPost(post.id)}>{post.data.titulo}</a>
              </h2>
              <p>{post.data.descricao}</p>
              <span class="post-ler" aria-hidden="true">
                {t.rotulos.ler}
                <Fragment set:html={seta} />
              </span>
            </div>
          </li>
        );
      })}
    </ul>
  </Secao>

  <ChamadaFinal
    slot="fechamento"
    titulo="Ficou com uma dúvida sobre o seu site?"
    texto="Manda uma mensagem. A conversa inicial é pelo WhatsApp e não tem compromisso."
  />
</Base>
