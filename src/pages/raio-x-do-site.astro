---
import LandingPage from '../layouts/LandingPage.astro';
import BotaoRaioX from '../components/BotaoRaioX.astro';
import Cabeca from '../components/Cabeca.astro';
import Faq from '../components/Faq.astro';
import Passos from '../components/Passos.astro';
import Secao from '../components/Secao.astro';
import Topicos from '../components/Topicos.astro';
import { nomeCompleto } from '../data/empresa';
import type { NomeIcone } from '../data/icones';
import { prazoDias, preco, precoFormatado } from '../data/raioX';
import { rotas } from '../i18n/rotas';
import { raioX as t } from '../i18n/paginas/raioX';
import { metasPaginas } from '../i18n/textos';

/**
 * Landing page do Raio-X do site (conteudo.md, seção 11): uma oferta, uma ação, sem menu.
 * O botão vai para o link de pagamento; enquanto ele não existe, vai para o WhatsApp.
 */
const meta = metasPaginas.raioX;
const site = Astro.site!;
const url = new URL(rotas.raioX, site).href;
const iconesParaQuem: NomeIcone[] = ['olho', 'lupa', 'relogio', 'janela'];
const iconesRecebe: NomeIcone[] = ['lupa', 'velocimetro', 'escudo', 'documento', 'video'];
const iconesPassos: NomeIcone[] = ['certo', 'balao', 'documento'];
const paraQuem = t.paraQuem.itens.map((i, idx) => ({ icone: iconesParaQuem[idx]!, titulo: i }));
const recebe = t.recebe.itens.map((i, idx) => ({ icone: iconesRecebe[idx]!, ...i }));
const passos = t.comoFunciona.passos.map((p, idx) => ({ icone: iconesPassos[idx]!, ...p }));

const jsonLd = {
  '@type': 'Service',
  '@id': `${url}#servico`,
  name: 'Raio-X do site',
  serviceType: 'Análise de site: SEO, velocidade, segurança e LGPD',
  description: meta.descricao,
  url,
  provider: { '@id': `${site.origin}/#organizacao` },
  areaServed: 'BR',
  ...(preco !== null
    ? {
        offers: {
          '@type': 'Offer',
          price: preco,
          priceCurrency: 'BRL',
          url,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<LandingPage titulo={meta.titulo} descricao={meta.descricao} jsonLd={[jsonLd]}>
  <div data-raio-x>
    <div data-secao="abertura">
      <Cabeca
        titulo={t.abertura.titulo}
        texto={t.abertura.texto}
        foto="lupa"
        atributosTitulo={{
          'data-angulo-google': t.abertura.angulos.google,
          'data-angulo-seguranca': t.abertura.angulos.seguranca,
        }}
      >
        <div class="acoes">
          <BotaoRaioX evento="raio_x_cta_abertura" />
        </div>
        <p class="cabeca-apoio">{t.abertura.apoio}</p>
      </Cabeca>
    </div>

    <Secao tom="claro" aria-labelledby="para-quem-titulo" data-secao="para-quem">
      <div class="cabeca-secao">
        <h2 id="para-quem-titulo">{t.paraQuem.titulo}</h2>
      </div>
      <Topicos itens={paraQuem} class="topicos-4 revelar" />
    </Secao>

    <Secao aria-labelledby="recebe-titulo" data-secao="recebe">
      <div class="cabeca-secao">
        <h2 id="recebe-titulo">{t.recebe.titulo}</h2>
        <p>{t.recebe.texto}</p>
      </div>
      <Topicos itens={recebe} class="topicos-5 revelar" />
    </Secao>

    <Secao tom="claro" aria-labelledby="como-titulo" data-secao="como-funciona">
      <Passos titulo={t.comoFunciona.titulo} passos={passos} idTitulo="como-titulo" />
    </Secao>

    <Secao aria-labelledby="preco-titulo" data-secao="preco">
      <div class="cabeca-secao">
        <h2 id="preco-titulo">{t.preco.titulo}</h2>
      </div>
      <div class="oferta revelar">
        {preco !== null ? (
          <p class="oferta-valor">{precoFormatado(preco)}</p>
        ) : (
          <p class="pendente">{t.preco.pendente}</p>
        )}
        {prazoDias !== null && <p>{t.preco.prazo(prazoDias)}</p>}
        <p>{t.preco.inclui}</p>
        <BotaoRaioX evento="raio_x_cta_preco" />
        <p class="oferta-honesto">{t.preco.honesto}</p>
      </div>
    </Secao>

    <Secao tom="claro" miolo="faq-grade" aria-labelledby="faq-titulo" data-secao="faq">
      <h2 id="faq-titulo">{t.faq.titulo}</h2>
      <Faq itens={t.faq.itens} class="revelar" />
    </Secao>
  </div>

  <section
    slot="fechamento"
    class="faixa faixa-degrade chamada"
    aria-labelledby="fechamento-titulo"
    data-secao="fechamento"
  >
    <div class="miolo chamada-grade">
      <h2 id="fechamento-titulo">{t.fechamento.titulo}</h2>
      <p>{t.fechamento.texto}</p>
      <div class="acoes chamada-acoes">
        <BotaoRaioX evento="raio_x_cta_fechamento" rotulo={t.fechamento.acao} />
      </div>
      <p class="apagado">{nomeCompleto}</p>
    </div>
  </section>

  <script>
    import '../scripts/raio-x';
  </script>
</LandingPage>
