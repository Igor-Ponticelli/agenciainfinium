---
import { Font, fontData } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Cabecalho from '../components/Cabecalho.astro';
import Consentimento from '../components/Consentimento.astro';
import Fita from '../components/Fita.astro';
import Rodape from '../components/Rodape.astro';
import Seo from '../components/Seo.astro';
import { codigoIdioma } from '../i18n/rotas';
import { textos as t } from '../i18n/textos';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

/**
 * Layout das landing pages (TODO 8): sem menu, sem rodapé longo, nada que tire a pessoa da
 * página. Só o logo no topo (sem link) e, no fim, o logo, o contato e a privacidade.
 */
interface Props {
  titulo: string;
  descricao: string;
  jsonLd?: Record<string, unknown>[];
}

const seo = Astro.props;
const robotoLatin = fontData['--fonte-roboto']?.[0]?.src[0]?.url;
---

<!doctype html>
<html lang={codigoIdioma}>
  <head>
    <meta charset="utf-8" />
    <!-- Uma linha só, sem espaços: o hash deste script está na CSP do .htaccess -->
    <!-- prettier-ignore -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotoLatin && (
      <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
    )}
    <Font cssVariable="--fonte-roboto" />
    <Seo {...seo} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="landing">
    <a class="pular-conteudo" href="#conteudo">
      {t.pularParaConteudo}
    </a>
    <Cabecalho soLogo />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <div class="fechamento">
      <slot name="fechamento" />
      <Rodape curto />
    </div>
    <Consentimento />
    <Fita />
    <script>
      import '../scripts/metricas';
      import '../scripts/rolagem';
    </script>
  </body>
</html>
