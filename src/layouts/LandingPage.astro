---
import { Font, fontData } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import logoPrimary from '../assets/marca/logo-horizontal-primary.svg';
import logoWhite from '../assets/marca/logo-horizontal-white.svg';
import Consentimento from '../components/Consentimento.astro';
import Fita from '../components/Fita.astro';
import Seo from '../components/Seo.astro';
import { email, linkWhatsapp, nomeCompleto } from '../data/empresa';
import { codigoIdioma, rotas } from '../i18n/rotas';
import { raioX } from '../i18n/paginas/raioX';
import { textos as t } from '../i18n/textos';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

/**
 * Layout das landing pages (TODO 8): sem menu, sem rodapé longo, nada que tire a pessoa da
 * página. Só o logo no topo (sem link), a régua da fita e, no fim, o logo, a privacidade e o
 * contato. Mesmo mundo do site: a planilha.
 */
interface Props {
  titulo: string;
  descricao: string;
  jsonLd?: Record<string, unknown>[];
}

const seo = Astro.props;
const robotoLatin = fontData['--fonte-roboto']?.[0]?.src[0]?.url;
const altura = 28;
const largura = Math.round((altura * logoPrimary.width) / logoPrimary.height);
---

<!doctype html>
<html lang={codigoIdioma}>
  <head>
    <meta charset="utf-8" />
    <!-- Uma linha só, sem espaços: o hash deste script está na CSP do .htaccess -->
    <!-- prettier-ignore -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotoLatin && (
      <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
    )}
    <Font cssVariable="--fonte-roboto" />
    <Seo {...seo} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="landing">
    <a class="pular-conteudo" href="#conteudo">
      {t.pularParaConteudo}
    </a>
    <header class="cabecalho cabecalho-landing">
      <div class="cabecalho-faixa">
        <span class="logo">
          <img
            class="logo-claro"
            src={logoPrimary.src}
            width={largura}
            height={altura}
            alt={nomeCompleto}
            decoding="async"
          />
        </span>
      </div>
      <div class="regua" data-fita-regua aria-hidden="true"></div>
    </header>
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <div class="escuro fechamento">
      <slot name="fechamento" />
      <footer class="rodape rodape-landing">
        <div class="rodape-faixa">
          <div class="rodape-marca">
            <img
              src={logoWhite.src}
              width={largura}
              height={altura}
              alt={nomeCompleto}
              decoding="async"
            />
          </div>
          <ul class="rodape-links">
            <li>
              <a
                class="link-fita"
                href={linkWhatsapp()}
                target="_blank"
                rel="noopener"
                data-evento="whatsapp_rodape"
              >
                {raioX.rodape.contato}
                <span class="visualmente-oculto">{t.linkExterno}</span>
              </a>
            </li>
            <li>
              <a class="link-fita" href={`mailto:${email}`}>
                {email}
              </a>
            </li>
            <li>
              <a class="link-fita" href={rotas.privacidade}>
                {raioX.rodape.privacidade}
              </a>
            </li>
          </ul>
          <p class="rodape-empresa">{nomeCompleto}</p>
        </div>
      </footer>
    </div>
    <Consentimento />
    <Fita />
    <script>
      import '../scripts/metricas';
      import '../scripts/rolagem';
    </script>
  </body>
</html>
