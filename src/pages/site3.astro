---
import simbolo from '../assets/marca/simbolo-white.svg?raw';
import simboloMicro from '../assets/marca/simbolo-micro-lilac.svg';
import Versao from '../layouts/Versao.astro';
import Cabecalho from '../components/versoes/Cabecalho.astro';
import Foto from '../components/Foto.astro';
import Rodape from '../components/versoes/Rodape.astro';
import Vitrine from '../components/versoes/Vitrine.astro';
import { email, instagram, linkWhatsapp, type AssuntoWhatsapp } from '../data/empresa';
import type { NomeFoto } from '../data/fotos';
import { todosProjetos } from '../data/projetos';
import { rotas } from '../i18n/rotas';
import { textos } from '../i18n/textos';
import { versao3 as t } from '../i18n/paginas/versoes';
import '../styles/versoes/site3.css';

/**
 * Versão 3 de estudo: o infinito (direção de agência). Escura, no violeta profundo da marca,
 * tipo em caixa grande e editorial, o símbolo como motivo que se desenha, faixa rolante, serviços
 * como lista de obras, projetos em linhas largas sobre fundo claro, etapas com a cabeça fixa e a
 * chamada final gigante. Direção em .claude/docs/versoes.md.
 */
const projetos = await todosProjetos();
const laco = simbolo.replace('<path ', '<path pathLength="1" ');
const destinos: Record<string, string> = { sites: rotas.sites, sistemas: rotas.sistemas };
const seta =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const setaBaixo =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>';
const indice = (i: number) => String(i + 1).padStart(2, '0');
---

<Versao titulo={t.meta.titulo} descricao={t.meta.descricao} versao={3}>
  <Cabecalho tema="escuro" class="s3-cabecalho" />

  <main id="conteudo" tabindex="-1">
    <section class="s3-abertura" aria-labelledby="s3-titulo">
      <div class="v-faixa s3-abertura-grade">
        <span class="s3-abertura-simbolo" set:html={laco} aria-hidden="true" />
        <h1 id="s3-titulo">{t.abertura.titulo}</h1>
        <div class="s3-abertura-apoio">
          <p>{t.abertura.texto}</p>
          <div class="s3-acoes">
            <a
              class="s3-pilula"
              href={linkWhatsapp()}
              target="_blank"
              rel="noopener"
              data-evento="whatsapp_abertura"
            >
              {t.abertura.acao}
              <span class="visualmente-oculto">{textos.linkExterno}</span>
            </a>
            <a class="s3-link" href="#projetos">
              {t.abertura.link}
              <Fragment set:html={setaBaixo} />
            </a>
          </div>
        </div>
      </div>
      <div class="s3-rolante" aria-hidden="true">
        <div class="s3-rolante-trilho">
          {[0, 1].map(() =>
            t.abertura.faixa.map((item) => (
              <span class="s3-rolante-item">
                <img src={simboloMicro.src} width="20" height="10" alt="" decoding="async" />
                {item}
              </span>
            )),
          )}
        </div>
      </div>
    </section>

    <section class="s3-cena" aria-labelledby="s3-cena-titulo">
      <div class="v-faixa s3-cena-grade">
        <h2 class="s3-rotulo" id="s3-cena-titulo">
          {t.cena.titulo}
        </h2>
        <div class="s3-cena-frases v-revelar">
          {t.cena.frases.map((frase) => (
            <p class="s3-cena-frase">
              {frase.map((trecho, i) =>
                i % 2 === 1 ? <mark>{trecho}</mark> : <Fragment>{trecho}</Fragment>,
              )}
            </p>
          ))}
          <p class="s3-cena-texto">{t.cena.texto}</p>
        </div>
      </div>
    </section>

    <section class="s3-servicos" aria-labelledby="s3-servicos-titulo">
      <div class="v-faixa">
        <h2 class="s3-rotulo" id="s3-servicos-titulo">
          {t.servicos.titulo}
        </h2>
        <ol class="s3-lista-servicos">
          {t.servicos.itens.map((s) => (
            <li class="s3-servico v-revelar">
              <span class="s3-servico-numero" aria-hidden="true">
                {s.numero}
              </span>
              <div class="s3-servico-cabeca">
                <h3>{s.titulo}</h3>
                <p class="s3-servico-frase">{s.frase}</p>
              </div>
              <div class="s3-servico-corpo">
                <p>{s.texto}</p>
                <div class="s3-acoes">
                  <a
                    class="s3-link"
                    href={destinos[s.destino]}
                    data-evento={`servico_${s.assunto}`}
                  >
                    {s.ver}
                    <Fragment set:html={seta} />
                  </a>
                  <a
                    class="s3-link"
                    href={linkWhatsapp(s.assunto as AssuntoWhatsapp)}
                    target="_blank"
                    rel="noopener"
                    data-evento={`whatsapp_${s.destino}`}
                  >
                    {s.whatsapp}
                    <Fragment set:html={seta} />
                    <span class="visualmente-oculto">{textos.linkExterno}</span>
                  </a>
                </div>
              </div>
              <Foto
                class="s3-servico-foto"
                nome={s.foto as NomeFoto}
                tom="violeta"
                widths={[480, 800]}
                sizes="(min-width: 64rem) 16rem, 100vw"
              />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="s3-conexao" aria-labelledby="s3-conexao-titulo">
      <div class="v-faixa s3-conexao-grade v-revelar">
        <h2 id="s3-conexao-titulo">
          <span class="s3-conexao-antes">{t.conexao.antes}</span>
          <span class="s3-conexao-simbolo" set:html={laco} aria-hidden="true" />
          <span class="s3-conexao-depois">{t.conexao.depois}</span>
        </h2>
        <p>{t.conexao.texto}</p>
      </div>
    </section>

    <section class="s3-projetos s3-clara" id="projetos" aria-labelledby="s3-projetos-titulo">
      <div class="v-faixa">
        <div class="s3-cabeca v-revelar">
          <h2 id="s3-projetos-titulo">{t.projetos.titulo}</h2>
          <p>{t.projetos.texto}</p>
        </div>
        <ol class="s3-lista-projetos">
          {projetos.map((p, i) => (
            <li class="s3-projeto v-revelar">
              <Vitrine projeto={p} moldura="nua" proporcao="16 / 10" class="s3-projeto-vitrine" />
              <div class="s3-projeto-ficha">
                <span class="s3-projeto-indice" aria-hidden="true">
                  {indice(i)}
                </span>
                <h3>
                  <a href={`${rotas.projetos}${p.data.slug}/`}>{p.data.titulo}</a>
                </h3>
                <p class="s3-projeto-tipo">
                  {textos.projeto.tipo[p.data.tipo]} · {p.data.ano}
                </p>
                <p>{p.data.resumo}</p>
                <a class="s3-link" href={`${rotas.projetos}${p.data.slug}/`}>
                  {textos.acoes.verProjeto}
                  <Fragment set:html={seta} />
                  <span class="visualmente-oculto">: {p.data.titulo}</span>
                </a>
              </div>
            </li>
          ))}
        </ol>
        <a class="s3-link s3-link-grande" href={rotas.projetos}>
          {t.projetos.acao}
          <Fragment set:html={seta} />
        </a>
      </div>
    </section>

    <section class="s3-como" id="como-funciona" aria-labelledby="s3-como-titulo">
      <div class="v-faixa s3-como-grade">
        <div class="s3-como-fixo">
          <h2 id="s3-como-titulo">{t.comoFunciona.titulo}</h2>
          <p>{t.comoFunciona.texto}</p>
        </div>
        <ol class="s3-passos">
          {t.comoFunciona.passos.map((p, i) => (
            <li class="s3-passo v-revelar">
              <span class="s3-passo-numero" aria-hidden="true">
                {indice(i)}
              </span>
              <div>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="s3-resultados" aria-labelledby="s3-resultados-titulo">
      <div class="v-faixa">
        <h2 class="s3-rotulo" id="s3-resultados-titulo">
          {t.resultados.titulo}
        </h2>
        <ul class="s3-resultados-grade v-revelar">
          {t.resultados.itens.map((r) => (
            <li>
              <h3>{r.titulo}</h3>
              <p>{r.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="s3-faq" aria-labelledby="s3-faq-titulo">
      <div class="v-faixa s3-faq-grade">
        <h2 id="s3-faq-titulo">{t.faq.titulo}</h2>
        <div class="s3-faq-lista v-revelar">
          {t.faq.itens.map((i) => (
            <details class="s3-faq-item">
              <summary>{i.pergunta}</summary>
              <p>{i.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="s3-chamada" aria-labelledby="s3-chamada-titulo">
      <div class="v-faixa s3-chamada-grade">
        <h2 id="s3-chamada-titulo">{t.chamada.titulo}</h2>
        <p>{t.chamada.texto}</p>
        <div class="s3-acoes">
          <a
            class="s3-pilula s3-pilula-grande"
            href={linkWhatsapp()}
            target="_blank"
            rel="noopener"
            data-evento="whatsapp_chamada_final"
          >
            {t.chamada.acao}
            <span class="visualmente-oculto">{textos.linkExterno}</span>
          </a>
          <a class="s3-link" href={`mailto:${email}`} data-evento="email_chamada_final">
            {email}
          </a>
          <a class="s3-link" href={instagram.url} target="_blank" rel="noopener">
            {instagram.usuario}
            <span class="visualmente-oculto">{textos.linkExterno}</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Rodape tema="escuro" class="s3-rodape" />
</Versao>
