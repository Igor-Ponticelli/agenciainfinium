---
/**
 * A linha das letras de coluna da planilha (A a L). Decorativa: fica fora da árvore de
 * acessibilidade. O CSS esconde as letras que não cabem em cada largura.
 */
const letras = 'ABCDEFGHIJKL'.split('');
---

<div class="colunas" aria-hidden="true">
  <span class="num"></span>
  {letras.map((letra) => (
    <span class="coluna">{letra}</span>
  ))}
</div>
