---
import { Font, fontData } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Cabecalho from '../components/Cabecalho.astro';
import Consentimento from '../components/Consentimento.astro';
import Fita from '../components/Fita.astro';
import Rodape from '../components/Rodape.astro';
import Seo from '../components/Seo.astro';
import { linkWhatsapp } from '../data/empresa';
import { codigoIdioma } from '../i18n/rotas';
import { textos as t } from '../i18n/textos';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  titulo: string;
  descricao: string;
  tituloCompleto?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  tipoOg?: 'website' | 'article';
  /** Imagem Open Graph própria (caminho absoluto no site, 1200x630). */
  imagem?: string;
  /** A página de acessos não tem cabeçalho nem rodapé (conteudo.md, seção 1). */
  semCabecalho?: boolean;
  /**
   * A home abre escura: cabeçalho e o slot `abertura` ficam dentro do degradê da marca
   * (contrato da home). As outras páginas abrem claras.
   */
  aberturaEscura?: boolean;
}

const { semCabecalho = false, aberturaEscura = false, ...seo } = Astro.props;

// Preload só do arquivo latin da Roboto (a primeira variante em astro.config.ts).
// O filtro `preload` do <Font> não sabe o subset de fontes locais.
const robotoLatin = fontData['--fonte-roboto']?.[0]?.src[0]?.url;
---

<!doctype html>
<html lang={codigoIdioma}>
  <head>
    <meta charset="utf-8" />
    <!-- Uma linha só, sem espaços: o hash deste script está na CSP do .htaccess -->
    <!-- prettier-ignore -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotoLatin && (
      <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
    )}
    <Font cssVariable="--fonte-roboto" />
    <Seo {...seo} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class:list={{ 'sem-cabecalho': semCabecalho }}>
    <a class="pular-conteudo" href="#conteudo">
      {t.pularParaConteudo}
    </a>
    {!semCabecalho && (
      <div class:list={['topo', { escuro: aberturaEscura, 'topo-escuro': aberturaEscura }]}>
        <Cabecalho />
        <slot name="abertura" />
      </div>
    )}
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    {!semCabecalho && (
      <div class="escuro fechamento">
        <slot name="fechamento" />
        <Rodape />
      </div>
    )}
    {!semCabecalho && (
      <a
        class="whatsapp-flutuante"
        href={linkWhatsapp()}
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_flutuante"
      >
        {t.contato.whatsapp}
        <span class="visualmente-oculto">
          : {t.acoes.falarWhatsapp} {t.linkExterno}
        </span>
      </a>
    )}
    <Consentimento />
    <Fita />
    <script>
      import '../scripts/metricas';
      import '../scripts/rolagem';
      import '../scripts/flutuante';
    </script>
  </body>
</html>
