---
import type { HTMLAttributes } from 'astro/types';

/**
 * Uma faixa do site: largura inteira, com o próprio fundo e respiro, e o miolo centrado dentro.
 * Tons: `escuro` (o violeta profundo, padrão), `profundo` (mais escuro, das vitrines e do rodapé),
 * `degrade` (o degradê da marca) e `claro` (o Body, para leitura). O tom claro troca os tokens
 * semânticos pela classe `.claro` (tokens.css).
 */
interface Props extends HTMLAttributes<'section'> {
  tom?: 'escuro' | 'profundo' | 'degrade' | 'claro';
  /** Sem o miolo: a seção cuida da própria largura (abertura, faixa rolante, galeria). */
  cheia?: boolean;
  /** Classe do miolo. */
  miolo?: string;
}

const { tom = 'escuro', cheia = false, miolo, class: classe, ...resto } = Astro.props;
---

<section class:list={['faixa', `faixa-${tom}`, { claro: tom === 'claro' }, classe]} {...resto}>
  {cheia ? (
    <slot />
  ) : (
    <div class:list={['miolo', miolo]}>
      <slot />
    </div>
  )}
</section>
