---
import Base from '../layouts/Base.astro';
import Cabeca from '../components/Cabeca.astro';
import Formulario from '../components/Formulario.astro';
import Icone from '../components/Icone.astro';
import Secao from '../components/Secao.astro';
import { email, instagram, linkWhatsapp } from '../data/empresa';
import { contato as t } from '../i18n/paginas/contato';
import { metasPaginas, textos } from '../i18n/textos';

/** Contato: os canais em tópicos com ícone e o formulário ao lado, sobre o claro. */
const meta = metasPaginas.contato;
---

<Base titulo={meta.titulo} descricao={meta.descricao} semChamada>
  <Cabeca titulo={t.titulo} texto={t.texto} />

  <Secao tom="claro" miolo="contato-grade" aria-labelledby="formulario-titulo">
    <ul class="topicos contato-canais" aria-label="Canais de contato">
      <li class="topico">
        <Icone nome="whatsapp" tamanho={30} />
        <div class="topico-texto">
          <h3>
            <a
              class="link-fita"
              href={linkWhatsapp()}
              target="_blank"
              rel="noopener"
              data-evento="whatsapp_contato"
            >
              {t.canais.whatsapp.rotulo}
              <span class="visualmente-oculto">{textos.linkExterno}</span>
            </a>
          </h3>
          <p>{t.canais.whatsapp.texto}</p>
        </div>
      </li>
      <li class="topico">
        <Icone nome="envelope" tamanho={30} />
        <div class="topico-texto">
          <h3>
            <a class="link-fita" href={`mailto:${email}`} data-evento="email_contato">
              {email}
            </a>
          </h3>
          <p>{t.canais.email.texto}</p>
        </div>
      </li>
      <li class="topico">
        <Icone nome="instagram" tamanho={30} />
        <div class="topico-texto">
          <h3>
            <a class="link-fita" href={instagram.url} target="_blank" rel="noopener">
              {instagram.usuario}
              <span class="visualmente-oculto">{textos.linkExterno}</span>
            </a>
          </h3>
          <p>{t.canais.instagram.texto}</p>
        </div>
      </li>
    </ul>
    <Formulario />
  </Secao>
</Base>
