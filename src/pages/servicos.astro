---
import simbolo from '../assets/marca/simbolo-white.svg?raw';
import Base from '../layouts/Base.astro';
import Cabeca from '../components/Cabeca.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Icone from '../components/Icone.astro';
import Secao from '../components/Secao.astro';
import Topicos from '../components/Topicos.astro';
import type { NomeIcone } from '../data/icones';
import { linkWhatsapp } from '../data/empresa';
import { inicio } from '../i18n/paginas/inicio';
import { servicos as t } from '../i18n/paginas/servicos';
import { rotas } from '../i18n/rotas';
import { metasPaginas, textos } from '../i18n/textos';

/** Hub de serviços: a pergunta em três tópicos, os dois serviços lado a lado e a conexão. */
const meta = metasPaginas.servicos;
const destino = { sites: rotas.sites, sistemas: rotas.sistemas, whatsapp: linkWhatsapp() };
const iconesQual: NomeIcone[] = ['lupa', 'planilha', 'conexoes'];
const laco = simbolo.replace('<path ', '<path pathLength="1" ');
const servicos = [
  {
    ...t.sites,
    rota: rotas.sites,
    chave: 'sites' as const,
    topicos: inicio.servicos.sites.topicos,
  },
  {
    ...t.sistemas,
    rota: rotas.sistemas,
    chave: 'sistemas' as const,
    topicos: inicio.servicos.sistemas.topicos,
  },
];
---

<Base titulo={meta.titulo} descricao={meta.descricao} semChamada>
  <Cabeca titulo={t.titulo} texto={t.texto} />

  <Secao tom="claro" aria-labelledby="qual-titulo">
    <div class="cabeca-secao">
      <h2 id="qual-titulo">{t.qual.titulo}</h2>
    </div>
    <ul class="topicos topicos-3 revelar">
      {t.qual.opcoes.map((o, idx) => (
        <li class="topico">
          <Icone nome={iconesQual[idx]!} tamanho={30} />
          <div class="topico-texto">
            <h3>{o.problema}</h3>
            <p>{o.resposta}</p>
          </div>
          {o.destino === 'whatsapp' ? (
            <a
              class="botao"
              href={destino[o.destino]}
              target="_blank"
              rel="noopener"
              data-evento="whatsapp_hub"
            >
              {o.acao}
              <span class="visualmente-oculto">{textos.linkExterno}</span>
            </a>
          ) : (
            <a class="botao" href={destino[o.destino]} data-evento={`servico_${o.destino}`}>
              {o.acao}
            </a>
          )}
        </li>
      ))}
    </ul>
  </Secao>

  <Secao aria-label="Os dois serviços">
    <div class="topicos topicos-2">
      {servicos.map((s) => (
        <article class="topico revelar">
          <div class="topico-texto">
            <h2>{s.titulo}</h2>
            <p class="frase-chave">{s.frase}</p>
            <p>{s.texto}</p>
          </div>
          <Topicos itens={s.topicos} compactos />
          <a class="botao" href={s.rota} data-evento={`servico_${s.chave}`}>
            {s.acao}
          </a>
        </article>
      ))}
    </div>
  </Secao>

  <Secao tom="degrade" miolo="conexao-grade revelar" aria-labelledby="conexao-titulo">
    <h2 id="conexao-titulo">
      <span class="conexao-antes">{inicio.conexao.antes}</span>
      <span class="conexao-simbolo" set:html={laco} aria-hidden="true" />
      <span class="conexao-depois">{inicio.conexao.depois}</span>
    </h2>
    <p>{t.conexao.texto}</p>
  </Secao>

  <ChamadaFinal
    slot="fechamento"
    titulo={t.chamada.titulo}
    texto={t.chamada.texto}
    acao={t.chamada.acao}
  />
</Base>
