---
import { Font, fontData } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Cabecalho from '../components/Cabecalho.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Consentimento from '../components/Consentimento.astro';
import Fita from '../components/Fita.astro';
import Glifo from '../components/Glifo.astro';
import Rodape from '../components/Rodape.astro';
import Seo from '../components/Seo.astro';
import { linkWhatsapp } from '../data/empresa';
import { codigoIdioma } from '../i18n/rotas';
import { textos as t } from '../i18n/textos';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

/**
 * Layout do site: cabeçalho fixo, o conteúdo em faixas, a chamada final ("Vamos conversar?",
 * ou a que a página puser no slot `fechamento`) e o rodapé. Escuro por padrão, no violeta
 * profundo da marca (direcao-visual.md, seção 5, 05/11/2026).
 */
interface Props {
  titulo: string;
  descricao: string;
  tituloCompleto?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  tipoOg?: 'website' | 'article';
  /** Imagem Open Graph própria (caminho absoluto no site, 1200x630). */
  imagem?: string;
  /** A página de acessos não tem cabeçalho, chamada nem rodapé (conteudo.md, seção 1). */
  semCabecalho?: boolean;
  /** Sem a chamada final padrão (quando a página traz a sua no slot `fechamento`). */
  semChamada?: boolean;
}

const { semCabecalho = false, semChamada = false, ...seo } = Astro.props;

// Preload só do arquivo latin da Roboto (a primeira variante em astro.config.ts).
const robotoLatin = fontData['--fonte-roboto']?.[0]?.src[0]?.url;
---

<!doctype html>
<html lang={codigoIdioma}>
  <head>
    <meta charset="utf-8" />
    <!-- Uma linha só, sem espaços: o hash deste script está na CSP do .htaccess -->
    <!-- prettier-ignore -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotoLatin && (
      <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
    )}
    <Font cssVariable="--fonte-roboto" />
    <Seo {...seo} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class:list={{ 'sem-cabecalho': semCabecalho }}>
    <a class="pular-conteudo" href="#conteudo">
      {t.pularParaConteudo}
    </a>
    {!semCabecalho && <Cabecalho />}
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    {!semCabecalho && (
      <div class="fechamento">
        <slot name="fechamento">{!semChamada && <ChamadaFinal />}</slot>
        <Rodape />
      </div>
    )}
    {!semCabecalho && (
      <a
        class="whatsapp-flutuante"
        href={linkWhatsapp()}
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_flutuante"
      >
        <Glifo nome="whatsapp" tamanho={20} />
        {t.contato.whatsapp}
        <span class="visualmente-oculto">
          : {t.acoes.falarWhatsapp} {t.linkExterno}
        </span>
      </a>
    )}
    <Consentimento />
    <Fita />
    <script>
      import '../scripts/metricas';
      import '../scripts/rolagem';
      import '../scripts/flutuante';
    </script>
  </body>
</html>
