---
import Base from '../layouts/Base.astro';
import Cartao from '../components/Cartao.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import FontesPrevias from '../components/FontesPrevias.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import Linha from '../components/Linha.astro';
import Obra from '../components/Obra.astro';
import Secao from '../components/Secao.astro';
import { dataCurta, dataDoPost, dataIso, postsPublicados } from '../data/blog';
import type { NomeIcone } from '../data/icones';
import { todosProjetos } from '../data/projetos';
import { blog as tb } from '../i18n/paginas/blog';
import { rotaPost } from '../i18n/rotas';
import { linkWhatsapp } from '../data/empresa';
import { rotas } from '../i18n/rotas';
import { inicio as t } from '../i18n/paginas/inicio';
import { metasPaginas } from '../i18n/textos';

/**
 * Home: a planilha que vira sistema (contrato em .impeccable/surfaces/src-pages-index-astro.md),
 * em bandas (decisão do Igor, 31/10/2026): abertura escura com a foto; a cena do problema é a
 * planilha de verdade; os dois serviços são células mescladas com foto; a conexão volta ao
 * degradê; os projetos ficam fora da grade; os resultados são cartões com ícone; a chamada
 * final fecha a planilha.
 */
const meta = metasPaginas.inicio;
const projetos = await todosProjetos();
const posts = (await postsPublicados()).slice(0, 3);

// Pares desencontrados: grande com a ficha ao lado, média com a ficha embaixo, e o inverso.
const formato = (i: number) => ([0, 3].includes(i % 4) ? 'grande' : 'media');
const ficha = (i: number) => ([0, 3].includes(i % 4) ? 'lado' : 'abaixo');

// A ferramenta de cada linha da cena, e o ícone de cada resultado
const iconesCena: NomeIcone[] = ['balao', 'planilha', 'quadro', 'nota'];
const iconesResultados: NomeIcone[] = ['relogio', 'certo', 'usuarios', 'painel', 'crescimento'];
---

<Base titulo={meta.titulo} descricao={meta.descricao} tituloCompleto aberturaEscura>
  <FontesPrevias slot="head" />
  <section slot="abertura" class="abertura folha" aria-labelledby="assinatura">
    <Linha class="abertura-assinatura">
      <h1 id="assinatura">{t.abertura.titulo}</h1>
    </Linha>
    <Linha>
      <p class="abertura-frase">{t.abertura.texto}</p>
    </Linha>
    <Linha>
      <div class="abertura-acoes acoes">
        <a
          class="botao botao-claro"
          href={linkWhatsapp()}
          target="_blank"
          rel="noopener"
          data-evento="whatsapp_abertura"
        >
          {t.abertura.acaoPrincipal}
          <span class="visualmente-oculto">(abre em nova aba)</span>
        </a>
        <a class="link-fita" href={`#${t.abertura.ancoraComoFunciona}`}>
          {t.abertura.acaoSecundaria}
        </a>
      </div>
    </Linha>
    <Foto
      class="abertura-foto"
      nome="celular"
      tom="violeta"
      prioridade
      posicao="50% 35%"
      sizes="(min-width: 64rem) 34rem, 100vw"
      widths={[480, 800, 1100, 1600]}
    />
  </section>

  <Secao folha="cena" aria-labelledby="cena-titulo">
    <Linha class="cena-titulo">
      <h2 class="titulo-secao" id="cena-titulo">
        {t.problema.titulo}
      </h2>
    </Linha>
    <div class="cena-tabela">
      {t.problema.celulas.map(([chave, valor], i) => (
        <div class="cena-linha">
          <span class="cena-chave">{chave}</span>
          <span class="cena-valor">
            {iconesCena[i] && <Icone nome={iconesCena[i]} class="icone-inline" tamanho={22} />}
            {valor}
          </span>
        </div>
      ))}
      <Foto
        class="cena-foto"
        nome="planilha"
        posicao="50% 45%"
        sizes="(min-width: 64rem) 34rem, 100vw"
      />
      <div class="cena-texto texto">
        {t.problema.paragrafos.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </Secao>

  <Secao tom="branco" aria-labelledby="servicos-titulo">
    <Linha>
      <h2 class="titulo-secao" id="servicos-titulo">
        {t.servicos.titulo}
      </h2>
    </Linha>
    <Linha class="servicos-linha">
      {[
        {
          ...t.servicos.sites,
          classe: 'servico-sites',
          rota: rotas.sites,
          assunto: 'site' as const,
          evento: 'whatsapp_sites',
          foto: 'entre' as const,
        },
        {
          ...t.servicos.sistemas,
          classe: 'servico-sistemas',
          rota: rotas.sistemas,
          assunto: 'sistema' as const,
          evento: 'whatsapp_sistemas',
          foto: 'estoque' as const,
        },
      ].map((s) => (
        <article class:list={['servico', 'mesclada', s.classe]}>
          <Foto class="servico-foto" nome={s.foto} sizes="(min-width: 64rem) 40rem, 100vw" />
          <h3>{s.titulo}</h3>
          <p class="servico-frase">{s.frase}</p>
          <p>{s.texto}</p>
          <p class="servico-para">{s.paraQuem}</p>
          <div class="acoes">
            <a class="botao" href={s.rota} data-evento={`servico_${s.assunto}`}>
              {s.verServico}
            </a>
            <a
              class="link-fita"
              href={linkWhatsapp(s.assunto)}
              target="_blank"
              rel="noopener"
              data-evento={s.evento}
            >
              {s.whatsapp}
              <span class="visualmente-oculto">(abre em nova aba)</span>
            </a>
          </div>
        </article>
      ))}
    </Linha>
  </Secao>

  <Secao tom="escuro" aria-labelledby="conexao-titulo">
    <Linha class="conexao">
      <div class="conexao-texto">
        <h2 id="conexao-titulo">{t.conexao.titulo}</h2>
        <p>{t.conexao.texto}</p>
      </div>
      <svg
        class="conexao-laco"
        viewBox="0 0 1200 240"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path pathLength="1" d="M -20 212 C 300 212 500 212 660 204 S 1000 150 1230 100" />
        <path pathLength="1" d="M -20 42 C 180 42 360 30 520 30" />
      </svg>
    </Linha>
  </Secao>

  <Secao folha="vitrines" id="projetos" aria-labelledby="projetos-titulo">
    <Linha class="vitrines-cabeca">
      <h2 class="titulo-secao" id="projetos-titulo">
        {t.projetos.titulo}
      </h2>
      <p class="celula celula-apoio">{t.projetos.texto}</p>
      <a class="link-fita" href={rotas.projetos}>
        {t.projetos.acao}
      </a>
    </Linha>
    <div class="vitrines-grade">
      {projetos.map((p, i) => (
        <Obra projeto={p} formato={formato(i)} ficha={ficha(i)} />
      ))}
    </div>
  </Secao>

  <Secao tom="branco" id={t.abertura.ancoraComoFunciona} aria-labelledby="como-titulo">
    <Linha>
      <h2 class="titulo-secao" id="como-titulo">
        {t.comoFunciona.titulo}
      </h2>
      <p class="celula celula-apoio">{t.comoFunciona.texto}</p>
    </Linha>
    <ol class="passos" data-laco>
      {t.comoFunciona.passos.map((p) => (
        <Linha as="li" class="passo">
          <span class="passo-indice" aria-hidden="true"></span>
          <h3 class="passo-titulo">{p.titulo}</h3>
          <p class="passo-texto">{p.texto}</p>
        </Linha>
      ))}
    </ol>
  </Secao>

  <Secao aria-labelledby="resultados-titulo">
    <Linha>
      <h2 class="titulo-secao" id="resultados-titulo">
        {t.resultados.titulo}
      </h2>
    </Linha>
    <Linha class="cartoes" data-cartoes={t.resultados.itens.length}>
      {t.resultados.itens.map((i, idx) => (
        <Cartao icone={iconesResultados[idx]} titulo={i.titulo} texto={i.texto} />
      ))}
    </Linha>
  </Secao>

  {posts.length > 0 && (
    <Secao tom="branco" aria-labelledby="posts-titulo">
      <Linha>
        <h2 class="titulo-secao" id="posts-titulo">
          {tb.rotulos.naHome}
        </h2>
      </Linha>
      {posts.map((post) => {
        const data = dataDoPost(post);
        return (
          <Linha class="home-posts-linha">
            <Foto
              class="home-posts-capa"
              nome={post.data.capa}
              widths={[360, 640]}
              sizes="(min-width: 64rem) 12rem, 50vw"
            />
            <div class="home-posts-item">
              <time datetime={dataIso(data)}>{dataCurta(data)}</time>
              <a class="link-fita" href={rotaPost(post.id)}>
                {post.data.titulo}
              </a>
            </div>
          </Linha>
        );
      })}
      <Linha>
        <a class="link-fita home-posts-todos" href={rotas.blog}>
          {tb.rotulos.verBlog}
        </a>
      </Linha>
    </Secao>
  )}

  <Secao aria-labelledby="faq-titulo">
    <Linha>
      <h2 class="titulo-secao" id="faq-titulo">
        {t.faq.titulo}
      </h2>
    </Linha>
    {t.faq.itens.map((i) => (
      <Linha>
        <details class="faq-item">
          <summary>{i.pergunta}</summary>
          <p>{i.resposta}</p>
        </details>
      </Linha>
    ))}
  </Secao>

  <ChamadaFinal
    slot="fechamento"
    titulo={t.chamadaFinal.titulo}
    texto={t.chamadaFinal.texto}
    acao={t.chamadaFinal.acao}
    href={linkWhatsapp()}
    evento="whatsapp_chamada_final"
  />
</Base>
