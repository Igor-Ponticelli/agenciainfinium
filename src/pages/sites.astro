---
import Base from '../layouts/Base.astro';
import Cabeca from '../components/Cabeca.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Dupla from '../components/Dupla.astro';
import Faq from '../components/Faq.astro';
import FontesPrevias from '../components/FontesPrevias.astro';
import Galeria from '../components/Galeria.astro';
import Passos from '../components/Passos.astro';
import Secao from '../components/Secao.astro';
import Topicos from '../components/Topicos.astro';
import type { NomeIcone } from '../data/icones';
import { todosProjetos } from '../data/projetos';
import { linkWhatsapp } from '../data/empresa';
import { inicio } from '../i18n/paginas/inicio';
import { sites as t } from '../i18n/paginas/sites';
import { rotas } from '../i18n/rotas';
import { metasPaginas, textos } from '../i18n/textos';

/**
 * Página de sites: a cabeça com a foto, o problema em dupla, o que a gente faz e o que todo
 * site inclui em tópicos com ícone, as etapas, os três sites publicados e as perguntas.
 */
const meta = metasPaginas.sites;
const projetos = (await todosProjetos()).filter((p) => p.data.tipo === 'site');
const iconesTipos: NomeIcone[] = ['janela', 'alvo', 'etiqueta'];
const iconesInclui: NomeIcone[] = ['telas', 'raio', 'lupa', 'balao', 'grafico', 'cadeado'];
const iconesPassos: NomeIcone[] = ['balao', 'documento', 'olho', 'quadro', 'globo', 'ciclo'];
const tipos = t.tipos.itens.map((i, idx) => ({ icone: iconesTipos[idx]!, ...i }));
const inclui = t.inclui.itens.map((i, idx) => ({ icone: iconesInclui[idx]!, titulo: i }));
const passos = t.comoFunciona.passos.map((p, idx) => ({ icone: iconesPassos[idx]!, ...p }));
const site = Astro.site!;
const jsonLd = {
  '@type': 'Service',
  '@id': new URL(rotas.sites, site).href + '#servico',
  name: 'Criação de sites',
  serviceType: 'Criação de sites institucionais, landing pages e páginas de venda',
  description: meta.descricao,
  url: new URL(rotas.sites, site).href,
  provider: { '@id': `${site.origin}/#organizacao` },
  areaServed: 'BR',
};
---

<Base titulo={meta.titulo} descricao={meta.descricao} jsonLd={[jsonLd]} semChamada>
  <FontesPrevias slot="head" />
  <Cabeca titulo={t.titulo} frase={t.frase} texto={t.texto} foto="aberto">
    <div class="acoes">
      <a
        class="botao"
        href={linkWhatsapp('site')}
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_sites_topo"
      >
        {t.acao}
        <span class="visualmente-oculto">{textos.linkExterno}</span>
      </a>
    </div>
  </Cabeca>

  <Secao aria-labelledby="problema-titulo">
    <Dupla foto="lupaGlobo" tom="violeta" class="revelar">
      <h2 id="problema-titulo">{t.problema.titulo}</h2>
      <p>{t.problema.texto}</p>
    </Dupla>
  </Secao>

  <Secao tom="claro" aria-labelledby="tipos-titulo">
    <div class="cabeca-secao">
      <h2 id="tipos-titulo">{t.tipos.titulo}</h2>
    </div>
    <Topicos itens={tipos} class="topicos-3 revelar" />
  </Secao>

  <Secao tom="claro" aria-labelledby="inclui-titulo">
    <div class="cabeca-secao">
      <h2 id="inclui-titulo">{t.inclui.titulo}</h2>
    </div>
    <Topicos itens={inclui} class="topicos-3 revelar" />
  </Secao>

  <Secao aria-labelledby="como-titulo">
    <Passos titulo={t.comoFunciona.titulo} passos={passos} idTitulo="como-titulo" />
  </Secao>

  <Secao tom="profundo" cheia aria-labelledby="prova-titulo">
    <div class="miolo">
      <div class="cabeca-secao">
        <h2 id="prova-titulo">{t.prova.titulo}</h2>
        <p>{t.prova.texto}</p>
      </div>
    </div>
    <Galeria
      projetos={projetos}
      anterior={inicio.projetos.anterior}
      proximo={inicio.projetos.proximo}
    />
  </Secao>

  <Secao miolo="faq-grade" aria-labelledby="faq-titulo">
    <h2 id="faq-titulo">{t.faq.titulo}</h2>
    <Faq itens={t.faq.itens} class="revelar" />
  </Secao>

  <ChamadaFinal
    slot="fechamento"
    titulo={t.chamada.titulo}
    texto={t.chamada.texto}
    acao={t.chamada.acao}
    href={linkWhatsapp('site')}
    secundaria={{ rotulo: t.chamada.formulario, href: rotas.contato }}
  />
</Base>
