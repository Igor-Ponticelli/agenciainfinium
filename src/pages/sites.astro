---
import Base from '../layouts/Base.astro';
import { todosProjetos } from '../data/projetos';
import { linkWhatsapp } from '../data/empresa';
import { rotaProjeto, rotas } from '../i18n/rotas';
import { sites as t } from '../i18n/paginas/sites';
import { metasPaginas } from '../i18n/textos';

const meta = metasPaginas.sites;
const projetos = (await todosProjetos()).filter((p) => p.data.tipo === 'site');
---

<Base titulo={meta.titulo} descricao={meta.descricao}>
  <h1>{t.titulo}</h1>
  <p>{t.frase}</p>
  <p>{t.texto}</p>
  <p>
    <a href={linkWhatsapp('site')}>{t.acao}</a>
  </p>

  <section>
    <h2>{t.problema.titulo}</h2>
    <p>{t.problema.texto}</p>
  </section>

  <section>
    <h2>{t.tipos.titulo}</h2>
    {t.tipos.itens.map((i) => (
      <article>
        <h3>{i.titulo}</h3>
        <p>{i.texto}</p>
      </article>
    ))}
  </section>

  <section>
    <h2>{t.inclui.titulo}</h2>
    <ul>
      {t.inclui.itens.map((i) => (
        <li>{i}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{t.comoFunciona.titulo}</h2>
    <ol>
      {t.comoFunciona.passos.map((p) => (
        <li>
          <strong>{p.titulo}.</strong> {p.texto}
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>{t.prova.titulo}</h2>
    <p>{t.prova.texto}</p>
    <ul>
      {projetos.map((p) => (
        <li>
          <a href={rotaProjeto(p.data.slug)}>{p.data.titulo}</a>: {p.data.resumo}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{t.faq.titulo}</h2>
    {t.faq.itens.map((i) => (
      <details>
        <summary>{i.pergunta}</summary>
        <p>{i.resposta}</p>
      </details>
    ))}
  </section>

  <section>
    <h2>{t.chamada.titulo}</h2>
    <p>{t.chamada.texto}</p>
    <p>
      <a href={linkWhatsapp('site')}>{t.chamada.acao}</a>
      <a href={rotas.contato}>{t.chamada.formulario}</a>
    </p>
  </section>
</Base>
