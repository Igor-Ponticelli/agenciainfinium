---
import { icones, type NomeIcone } from '../data/icones';

/**
 * Um ícone de traço, vivo: o traço base, desenhado pela fita conforme a rolagem, e por cima uma
 * luz na cor do acento que corre pelo traço sem parar (site.css: `.icone`). Decorativo: sempre
 * acompanha um texto, por isso fica fora da árvore de acessibilidade. Com movimento reduzido,
 * o ícone aparece desenhado e a luz fica parada.
 */
interface Props {
  nome: NomeIcone;
  tamanho?: number;
  class?: string;
}

const { nome, tamanho = 28, class: classe } = Astro.props;
---

<span class:list={['icone', classe]} aria-hidden="true">
  <svg
    class="icone-base"
    viewBox="0 0 24 24"
    width={tamanho}
    height={tamanho}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icones[nome]}
  />
  <svg
    class="icone-luz"
    viewBox="0 0 24 24"
    width={tamanho}
    height={tamanho}
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icones[nome]}
  />
</span>
