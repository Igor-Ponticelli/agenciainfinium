---
import Base from '../layouts/Base.astro';
import Colunas from '../components/Colunas.astro';
import Formulario from '../components/Formulario.astro';
import Linha from '../components/Linha.astro';
import { email, instagram, linkWhatsapp } from '../data/empresa';
import { contato as t } from '../i18n/paginas/contato';
import { metasPaginas, textos } from '../i18n/textos';

/** Contato: os canais em linhas da planilha e o formulário numa célula mesclada. */
const meta = metasPaginas.contato;
---

<Base titulo={meta.titulo} descricao={meta.descricao}>
  <section class="folha pagina-cabeca" aria-labelledby="pagina-titulo">
    <Colunas />
    <Linha>
      <h1 class="pagina-titulo" id="pagina-titulo">
        {t.titulo}
      </h1>
    </Linha>
    <Linha>
      <p class="pagina-texto">{t.texto}</p>
    </Linha>
  </section>

  <section class="folha" aria-label="Canais de contato">
    <Linha>
      <a
        class="canal-nome link-fita"
        href={linkWhatsapp()}
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_contato"
      >
        {t.canais.whatsapp.rotulo}
        <span class="visualmente-oculto">{textos.linkExterno}</span>
      </a>
      <p class="canal-texto">{t.canais.whatsapp.texto}</p>
    </Linha>
    <Linha>
      <a class="canal-nome link-fita" href={`mailto:${email}`} data-evento="email_contato">
        {email}
      </a>
      <p class="canal-texto">{t.canais.email.texto}</p>
    </Linha>
    <Linha>
      <a class="canal-nome link-fita" href={instagram.url} target="_blank" rel="noopener">
        {instagram.usuario}
        <span class="visualmente-oculto">{textos.linkExterno}</span>
      </a>
      <p class="canal-texto">{t.canais.instagram.texto}</p>
    </Linha>
  </section>

  <section class="folha" aria-labelledby="formulario-titulo">
    <Linha class="servicos-linha">
      <Formulario />
    </Linha>
  </section>
</Base>
