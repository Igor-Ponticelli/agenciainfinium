---
import { Font, fontData } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Cabecalho from '../components/Cabecalho.astro';
import Seo from '../components/Seo.astro';
import { codigoIdioma } from '../i18n/rotas';
import { textos as t } from '../i18n/textos';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  titulo: string;
  descricao: string;
  tituloCompleto?: boolean;
  noindex?: boolean;
  /** A página de acessos não tem cabeçalho (conteudo.md, seção 1). */
  semCabecalho?: boolean;
}

const { semCabecalho = false, ...seo } = Astro.props;

// Preload só do arquivo latin da Roboto (a primeira variante em astro.config.ts).
// O filtro `preload` do <Font> não sabe o subset de fontes locais.
const robotoLatin = fontData['--fonte-roboto']?.[0]?.src[0]?.url;
---

<!doctype html>
<html lang={codigoIdioma}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotoLatin && (
      <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
    )}
    <Font cssVariable="--fonte-roboto" />
    <Seo {...seo} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">
      {t.pularParaConteudo}
    </a>
    {!semCabecalho && <Cabecalho />}
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
