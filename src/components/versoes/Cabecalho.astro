---
import logoPrimary from '../../assets/marca/logo-horizontal-primary.svg';
import logoWhite from '../../assets/marca/logo-horizontal-white.svg';
import { linkWhatsapp } from '../../data/empresa';
import { rotas } from '../../i18n/rotas';
import { textos as t } from '../../i18n/textos';

/**
 * Cabeçalho das versões de estudo: a mesma estrutura nas três (logo pelo arquivo SVG, menu
 * plano, botão do WhatsApp, painel de tela cheia no celular pelo menu.ts do site), e a pele de
 * cada versão no CSS dela. `tema="escuro"` mostra o logo branco (sobre o degradê ou o Ink).
 */
interface Props {
  tema?: 'claro' | 'escuro';
  /** Rótulo do botão principal. */
  acao?: string;
  class?: string;
}

const { tema = 'claro', acao = t.acoes.falarWhatsapp, class: classe } = Astro.props;
const altura = 28;
const largura = Math.round((altura * logoPrimary.width) / logoPrimary.height);
const itens = [
  { rotulo: t.menu.sites, href: rotas.sites },
  { rotulo: t.menu.sistemas, href: rotas.sistemas },
  { rotulo: t.menu.projetos, href: rotas.projetos },
  { rotulo: t.menu.blog, href: rotas.blog },
  { rotulo: t.menu.contato, href: rotas.contato },
];
---

<header class:list={['v-cabecalho', { 'v-escuro': tema === 'escuro' }, classe]}>
  <div class="v-cabecalho-faixa">
    <a class="v-logo" href={rotas.inicio} aria-label={t.logo}>
      <img
        class="v-logo-claro"
        src={logoPrimary.src}
        width={largura}
        height={altura}
        alt=""
        aria-hidden="true"
        decoding="async"
      />
      <img
        class="v-logo-escuro"
        src={logoWhite.src}
        width={largura}
        height={altura}
        alt=""
        aria-hidden="true"
        decoding="async"
      />
    </a>
    <button
      class="v-menu-botao"
      type="button"
      aria-expanded="false"
      aria-controls="menu-painel"
      aria-label={t.menu.abrir}
      data-menu-botao
      data-rotulo-abrir={t.menu.abrir}
      data-rotulo-fechar={t.menu.fechar}
    >
      <span class="v-menu-botao-linhas" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
    <div class="v-menu-painel" id="menu-painel" data-menu-painel>
      <nav class="v-menu" aria-label={t.menu.rotulo}>
        <ul>
          {itens.map((i) => (
            <li>
              <a href={i.href}>{i.rotulo}</a>
            </li>
          ))}
        </ul>
      </nav>
      <a
        class="v-botao v-botao-cabecalho"
        href={linkWhatsapp()}
        target="_blank"
        rel="noopener"
        data-evento="whatsapp_menu"
      >
        {acao}
        <span class="visualmente-oculto">{t.linkExterno}</span>
      </a>
    </div>
  </div>
</header>

<script>
  import '../../scripts/menu';
</script>
