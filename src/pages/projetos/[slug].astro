---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';
import Colunas from '../../components/Colunas.astro';
import Linha from '../../components/Linha.astro';
import FontesPrevias from '../../components/FontesPrevias.astro';
import Obra from '../../components/Obra.astro';
import { todosProjetos, type Projeto } from '../../data/projetos';
import { linkWhatsapp } from '../../data/empresa';
import { rotaProjeto } from '../../i18n/rotas';
import { textos as t } from '../../i18n/textos';

export const getStaticPaths = (async () => {
  const projetos = await todosProjetos();
  return projetos.map((projeto) => ({ params: { slug: projeto.data.slug }, props: { projeto } }));
}) satisfies GetStaticPaths;

interface Props {
  projeto: Projeto;
}

/** Página de projeto: o case, com a prévia em tamanho grande e a ficha ao lado. */
const { projeto } = Astro.props;
const d = projeto.data;
const { Content } = await render(projeto);

// O último projeto volta ao primeiro.
const todos = await todosProjetos();
const proximo = todos[(todos.findIndex((p) => p.id === projeto.id) + 1) % todos.length]!;
const assunto = d.tipo === 'site' ? 'site' : 'sistema';
const site = Astro.site!;
const imagem = `/og/${d.slug}.png`;

const jsonLd = {
  '@type': d.tipo === 'site' ? 'WebSite' : 'SoftwareApplication',
  '@id': new URL(rotaProjeto(d.slug), site).href + '#obra',
  name: d.titulo,
  description: d.resumo,
  ...(d.url ? { url: d.url } : {}),
  dateCreated: String(d.ano),
  inLanguage: 'pt-BR',
  creator: { '@id': `${site.origin}/#organizacao` },
  ...(d.tipo === 'produto'
    ? { applicationCategory: 'BusinessApplication', operatingSystem: 'Web' }
    : {}),
};
---

<Base titulo={d.titulo} descricao={d.resumo} imagem={imagem} jsonLd={[jsonLd]}>
  <FontesPrevias slot="head" />
  <article>
    <section class="folha pagina-cabeca">
      <Colunas />
      <Linha>
        <h1 class="pagina-titulo">{d.titulo}</h1>
      </Linha>
      <Linha>
        <p class="pagina-texto">{d.resumo}</p>
      </Linha>
    </section>

    <section class="folha" aria-label={t.previa.rotulo(d.titulo, d.tipo)}>
      <div class="vitrines-grade projeto-obra">
        <Obra projeto={projeto} formato="grande" ficha="lado" completa />
      </div>
    </section>

    <section class="folha">
      <Linha>
        <div class="projeto-texto">
          <Content />
        </div>
      </Linha>
      <Linha>
        <a class="proximo" href={rotaProjeto(proximo.data.slug)}>
          <span class="proximo-rotulo">{t.acoes.proximoProjeto}</span>
          <span class="proximo-titulo">{proximo.data.titulo}</span>
        </a>
      </Linha>
    </section>
  </article>

  <ChamadaFinal
    slot="fechamento"
    titulo={
      d.tipo === 'site'
        ? 'Quer um site com a cara da sua empresa?'
        : 'Quer um sistema assim na sua empresa?'
    }
    acao={d.tipo === 'site' ? t.acoes.queroSite : t.acoes.queroSistema}
    href={linkWhatsapp(assunto)}
    evento="whatsapp_chamada_final"
  />
</Base>
