---
import simbolo from '../assets/marca/simbolo-white.svg?raw';
import Versao from '../layouts/Versao.astro';
import Cabecalho from '../components/versoes/Cabecalho.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import Rodape from '../components/versoes/Rodape.astro';
import Vitrine from '../components/versoes/Vitrine.astro';
import { dataCurta, dataDoPost, dataIso, postsPublicados } from '../data/blog';
import { linkWhatsapp } from '../data/empresa';
import type { NomeIcone } from '../data/icones';
import { todosProjetos } from '../data/projetos';
import { rotaPost, rotas } from '../i18n/rotas';
import { textos } from '../i18n/textos';
import { versao1 as t } from '../i18n/paginas/versoes';
import '../styles/versoes/site1.css';

/**
 * Versão 1 de estudo: a vitrine (direção Apple). Uma ideia por tela, texto centrado, o site do
 * cliente como produto; faixas inteiras alternando o degradê da marca, o Body e o White; duas
 * ações fixas (pílula e link com seta); nav fina e translúcida. Direção em
 * .claude/docs/versoes.md.
 */
const projetos = await todosProjetos();
const porSlug = (slug: string) => projetos.find((p) => p.data.slug === slug)!;
const posts = (await postsPublicados()).slice(0, 3);
const iconesCena: NomeIcone[] = ['balao', 'planilha', 'quadro', 'nota'];
const iconesResultados: NomeIcone[] = ['relogio', 'certo', 'usuarios', 'painel', 'crescimento'];
// O símbolo com pathLength, para a fita se desenhar por rolagem (site1.css)
const laco = simbolo.replace('<path ', '<path pathLength="1" ');
const seta =
  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';
---

<Versao titulo={t.meta.titulo} descricao={t.meta.descricao} versao={1}>
  <Cabecalho tema="escuro" class="s1-cabecalho" />

  <main id="conteudo" tabindex="-1">
    <section class="s1-faixa s1-abertura" aria-labelledby="s1-titulo">
      <div class="s1-miolo s1-abertura-texto">
        <h1 id="s1-titulo">{t.abertura.titulo}</h1>
        <p class="s1-apoio">{t.abertura.frase}</p>
        <div class="s1-acoes">
          <a
            class="s1-pilula s1-pilula-lilas"
            href={linkWhatsapp()}
            target="_blank"
            rel="noopener"
            data-evento="whatsapp_abertura"
          >
            {t.abertura.acao}
            <span class="visualmente-oculto">{textos.linkExterno}</span>
          </a>
          <a class="s1-link" href="#projetos">
            {t.abertura.link}
            <Fragment set:html={seta} />
          </a>
        </div>
      </div>
      <div class="s1-abertura-palco">
        <Vitrine
          projeto={porSlug('brisa-cafe')}
          moldura="navegador"
          proporcao="16 / 10"
          ativa
          class="s1-palco-navegador"
        />
        <Vitrine
          projeto={porSlug('lumaj')}
          moldura="celular"
          proporcao="9 / 19"
          ativa
          class="s1-palco-celular"
        />
      </div>
    </section>

    <section class="s1-faixa s1-clara s1-cena" aria-labelledby="s1-cena-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-cena-titulo">{t.cena.titulo}</h2>
        <div class="s1-cena-fluxo" aria-hidden="true">
          <ul class="s1-cena-soltas">
            {t.cena.ferramentas.map((f, i) => (
              <li>
                <Icone nome={iconesCena[i]} tamanho={22} />
                {f}
              </li>
            ))}
          </ul>
          <span class="s1-cena-seta" set:html={seta} />
          <span class="s1-cena-sistema">
            <Icone nome="painel" tamanho={22} />
            {t.cena.resultado}
          </span>
        </div>
        <div class="s1-texto">
          {t.cena.paragrafos.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="s1-faixa s1-branca s1-servicos" aria-labelledby="s1-servicos-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-servicos-titulo">{t.servicos.titulo}</h2>
      </div>
      <div class="s1-duplo">
        <article class="s1-bloco s1-bloco-sites v-revelar">
          <div class="s1-bloco-texto">
            <h3>{t.servicos.sites.titulo}</h3>
            <p class="s1-bloco-frase">{t.servicos.sites.frase}</p>
            <p>{t.servicos.sites.texto}</p>
            <div class="s1-acoes">
              <a class="s1-link" href={rotas.sites} data-evento="servico_site">
                {t.servicos.sites.ver}
                <Fragment set:html={seta} />
              </a>
              <a
                class="s1-link"
                href={linkWhatsapp('site')}
                target="_blank"
                rel="noopener"
                data-evento="whatsapp_sites"
              >
                {t.servicos.sites.whatsapp}
                <Fragment set:html={seta} />
                <span class="visualmente-oculto">{textos.linkExterno}</span>
              </a>
            </div>
          </div>
          <Foto class="s1-bloco-foto" nome="entre" sizes="(min-width: 46rem) 40rem, 100vw" />
        </article>
        <article class="s1-bloco s1-bloco-sistemas v-revelar">
          <div class="s1-bloco-texto">
            <h3>{t.servicos.sistemas.titulo}</h3>
            <p class="s1-bloco-frase">{t.servicos.sistemas.frase}</p>
            <p>{t.servicos.sistemas.texto}</p>
            <div class="s1-acoes">
              <a class="s1-link" href={rotas.sistemas} data-evento="servico_sistema">
                {t.servicos.sistemas.ver}
                <Fragment set:html={seta} />
              </a>
              <a
                class="s1-link"
                href={linkWhatsapp('sistema')}
                target="_blank"
                rel="noopener"
                data-evento="whatsapp_sistemas"
              >
                {t.servicos.sistemas.whatsapp}
                <Fragment set:html={seta} />
                <span class="visualmente-oculto">{textos.linkExterno}</span>
              </a>
            </div>
          </div>
          <Foto
            class="s1-bloco-foto"
            nome="estoque"
            tom="violeta"
            sizes="(min-width: 46rem) 40rem, 100vw"
          />
        </article>
      </div>
    </section>

    <section class="s1-faixa s1-escura s1-conexao" aria-labelledby="s1-conexao-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-conexao-titulo">{t.conexao.titulo}</h2>
        <div class="s1-laco" aria-hidden="true">
          <span class="s1-laco-rotulo s1-laco-site">{t.conexao.rotulos.site}</span>
          <span class="s1-laco-simbolo" set:html={laco} />
          <span class="s1-laco-rotulo s1-laco-sistema">{t.conexao.rotulos.sistema}</span>
        </div>
        <p class="s1-apoio">{t.conexao.texto}</p>
      </div>
    </section>

    <section
      class="s1-faixa s1-clara s1-projetos"
      id="projetos"
      aria-labelledby="s1-projetos-titulo"
    >
      <div class="s1-miolo v-revelar">
        <h2 id="s1-projetos-titulo">{t.projetos.titulo}</h2>
        <p class="s1-apoio">{t.projetos.texto}</p>
      </div>
      <div class="s1-galeria" data-galeria>
        <ul class="s1-galeria-trilho" data-galeria-trilho>
          {projetos.map((p) => (
            <li class="s1-galeria-item">
              <Vitrine projeto={p} moldura="navegador" proporcao="16 / 10" />
              <div class="s1-galeria-ficha">
                <h3>
                  <a href={`${rotas.projetos}${p.data.slug}/`}>{p.data.titulo}</a>
                </h3>
                <p>{p.data.resumo}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="s1-galeria-botoes">
          <button type="button" aria-label={t.projetos.anterior} data-galeria-anterior>
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 6-6 6 6 6" />
            </svg>
          </button>
          <button type="button" aria-label={t.projetos.proximo} data-galeria-proximo>
            <Fragment set:html={seta.replace('width="16" height="16"', 'width="20" height="20"')} />
          </button>
        </div>
      </div>
      <div class="s1-miolo s1-centro">
        <a class="s1-link" href={rotas.projetos}>
          {t.projetos.acao}
          <Fragment set:html={seta} />
        </a>
      </div>
    </section>

    <section class="s1-faixa s1-branca s1-como" id="como-funciona" aria-labelledby="s1-como-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-como-titulo">{t.comoFunciona.titulo}</h2>
        <p class="s1-apoio">{t.comoFunciona.texto}</p>
      </div>
      <ol class="s1-passos v-revelar">
        {t.comoFunciona.passos.map((p, i) => (
          <li class="s1-passo">
            <span class="s1-passo-numero" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="s1-faixa s1-clara s1-resultados" aria-labelledby="s1-resultados-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-resultados-titulo">{t.resultados.titulo}</h2>
      </div>
      <ul class="s1-resultados-grade v-revelar">
        {t.resultados.itens.map((r, i) => (
          <li>
            <Icone nome={iconesResultados[i]} tamanho={28} />
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </li>
        ))}
      </ul>
    </section>

    {posts.length > 0 && (
      <section class="s1-faixa s1-branca s1-blog" aria-labelledby="s1-blog-titulo">
        <div class="s1-miolo v-revelar">
          <h2 id="s1-blog-titulo">{t.blog.titulo}</h2>
        </div>
        <ul class="s1-posts v-revelar">
          {posts.map((post) => {
            const data = dataDoPost(post);
            return (
              <li class="s1-post">
                <Foto
                  class="s1-post-capa"
                  nome={post.data.capa}
                  widths={[480, 800]}
                  sizes="(min-width: 46rem) 22rem, 100vw"
                />
                <time datetime={dataIso(data)}>{dataCurta(data)}</time>
                <h3>
                  <a href={rotaPost(post.id)}>{post.data.titulo}</a>
                </h3>
              </li>
            );
          })}
        </ul>
        <div class="s1-miolo s1-centro">
          <a class="s1-link" href={rotas.blog}>
            {t.blog.acao}
            <Fragment set:html={seta} />
          </a>
        </div>
      </section>
    )}

    <section class="s1-faixa s1-clara s1-faq" aria-labelledby="s1-faq-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-faq-titulo">{t.faq.titulo}</h2>
        <div class="s1-faq-lista">
          {t.faq.itens.map((i) => (
            <details class="s1-faq-item">
              <summary>{i.pergunta}</summary>
              <p>{i.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="s1-faixa s1-escura s1-chamada" aria-labelledby="s1-chamada-titulo">
      <div class="s1-miolo v-revelar">
        <h2 id="s1-chamada-titulo">{t.chamada.titulo}</h2>
        <p class="s1-apoio">{t.chamada.texto}</p>
        <div class="s1-acoes">
          <a
            class="s1-pilula s1-pilula-branca"
            href={linkWhatsapp()}
            target="_blank"
            rel="noopener"
            data-evento="whatsapp_chamada_final"
          >
            {t.chamada.acao}
            <span class="visualmente-oculto">{textos.linkExterno}</span>
          </a>
          <a class="s1-link" href={rotas.contato}>
            {t.chamada.link}
            <Fragment set:html={seta} />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Rodape tema="claro" class="s1-rodape" />

  <script>
    import '../scripts/versoes/galeria';
  </script>
</Versao>
