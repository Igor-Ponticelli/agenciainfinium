---
import Base from '../layouts/Base.astro';
import Cartao from '../components/Cartao.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import FontesPrevias from '../components/FontesPrevias.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import Linha from '../components/Linha.astro';
import Obra from '../components/Obra.astro';
import Secao from '../components/Secao.astro';
import type { NomeIcone } from '../data/icones';
import { todosProjetos } from '../data/projetos';
import { linkWhatsapp } from '../data/empresa';
import { rotas } from '../i18n/rotas';
import { sistemas as t } from '../i18n/paginas/sistemas';
import { metasPaginas } from '../i18n/textos';

/**
 * Página de sistemas: a planilha do serviço, em bandas. A tabela "antes e depois" é o momento
 * da direção: células com borda de um lado, uma célula mesclada em Primary do outro. As quatro
 * células de "um sistema só" e os benefícios levam o ícone da fita (brief da página de serviço,
 * revisto em 31/10/2026).
 */
const meta = metasPaginas.sistemas;
const produtos = (await todosProjetos()).filter((p) => p.data.tipo === 'produto');
const iconesProblema: NomeIcone[] = ['planilha', 'quadro', 'nota', 'balao'];
const iconesSolucao: NomeIcone[] = ['banco', 'ciclo', 'conexoes', 'painel'];
const iconesBeneficios: NomeIcone[] = ['relogio', 'certo', 'usuarios', 'olho', 'crescimento'];
const site = Astro.site!;
const jsonLd = {
  '@type': 'Service',
  '@id': new URL(rotas.sistemas, site).href + '#servico',
  name: 'Sistemas sob medida e automação de processos',
  serviceType: 'Desenvolvimento de sistemas sob medida e automação de processos',
  description: meta.descricao,
  url: new URL(rotas.sistemas, site).href,
  provider: { '@id': `${site.origin}/#organizacao` },
  areaServed: 'BR',
};
---

<Base titulo={meta.titulo} descricao={meta.descricao} jsonLd={[jsonLd]}>
  <FontesPrevias slot="head" />
  <Secao
    cabeca
    folha="pagina-cabeca cabeca-com-foto"
    aria-labelledby="pagina-titulo"
    style="--cabeca-linhas: 4"
  >
    <Linha>
      <h1 class="pagina-titulo" id="pagina-titulo">
        {t.titulo}
      </h1>
    </Linha>
    <Linha class="linha-selecionada">
      <p class="pagina-frase">{t.frase}</p>
    </Linha>
    <Linha>
      <p class="pagina-texto">{t.texto}</p>
    </Linha>
    <Linha>
      <div class="pagina-acao acoes">
        <a
          class="botao"
          href={linkWhatsapp('sistema')}
          target="_blank"
          rel="noopener"
          data-evento="whatsapp_sistemas_topo"
        >
          {t.acao}
          <span class="visualmente-oculto">(abre em nova aba)</span>
        </a>
      </div>
    </Linha>
    <Foto class="cabeca-foto" nome="postIts" prioridade sizes="(min-width: 64rem) 28rem, 100vw" />
  </Secao>

  <Secao tom="branco" aria-labelledby="problema-titulo">
    <Linha>
      <h2 class="titulo-secao" id="problema-titulo">
        {t.problema.titulo}
      </h2>
    </Linha>
    <ul class="lista-planilha">
      {t.problema.itens.map((i, idx) => (
        <Linha as="li">
          <span class="item-linha">
            {iconesProblema[idx] && (
              <Icone nome={iconesProblema[idx]} class="icone-inline" tamanho={22} />
            )}
            {i}
          </span>
        </Linha>
      ))}
    </ul>
    <Linha class="linha-texto">
      <div class="texto">
        <p>{t.problema.texto}</p>
      </div>
    </Linha>
  </Secao>

  <Secao aria-labelledby="solucao-titulo">
    <Linha>
      <h2 class="titulo-secao" id="solucao-titulo">
        {t.solucao.titulo}
      </h2>
      <p class="celula celula-apoio">{t.solucao.texto}</p>
    </Linha>
    <Linha class="fusao">
      {t.solucao.itens.map((i, idx) => (
        <div class="fusao-celula">
          {iconesSolucao[idx] && <Icone nome={iconesSolucao[idx]} />}
          <strong>{i.titulo}</strong>
          <p>{i.texto}</p>
        </div>
      ))}
    </Linha>
  </Secao>

  <Secao tom="branco" aria-labelledby="antes-depois-titulo">
    <Linha>
      <h2 class="titulo-secao" id="antes-depois-titulo">
        {t.antesDepois.titulo}
      </h2>
    </Linha>
    <div class="antes-depois" role="table" aria-labelledby="antes-depois-titulo">
      <div class="cabecalho-tabela" role="row">
        <span role="columnheader">{t.antesDepois.colunas.antes}</span>
        <span role="columnheader">{t.antesDepois.colunas.depois}</span>
      </div>
      <div class="corpo-tabela" role="rowgroup">
        {t.antesDepois.linhas.map((l) => (
          <div class="linha-tabela" role="row">
            <span class="antes" role="cell">
              {l.antes}
            </span>
            <span class="depois" role="cell">
              {l.depois}
            </span>
          </div>
        ))}
      </div>
    </div>
  </Secao>

  <Secao aria-labelledby="beneficios-titulo">
    <Linha>
      <h2 class="titulo-secao" id="beneficios-titulo">
        {t.beneficios.titulo}
      </h2>
    </Linha>
    <Linha class="cartoes" data-cartoes={t.beneficios.itens.length}>
      {t.beneficios.itens.map((i, idx) => (
        <Cartao icone={iconesBeneficios[idx]} titulo={i.titulo} texto={i.texto} />
      ))}
    </Linha>
  </Secao>

  <Secao tom="branco" aria-labelledby="como-titulo">
    <Linha>
      <h2 class="titulo-secao" id="como-titulo">
        {t.comoFunciona.titulo}
      </h2>
      <p class="celula celula-apoio">{t.comoFunciona.texto}</p>
    </Linha>
    <ol class="passos" data-laco data-laco-inicio="2">
      {t.comoFunciona.passos.map((p) => (
        <Linha as="li" class="passo">
          <span class="passo-indice" aria-hidden="true"></span>
          <h3 class="passo-titulo">{p.titulo}</h3>
          <p class="passo-texto">{p.texto}</p>
        </Linha>
      ))}
    </ol>
  </Secao>

  <Secao folha="vitrines" aria-labelledby="prova-titulo">
    <Linha class="vitrines-cabeca">
      <h2 class="titulo-secao" id="prova-titulo">
        {t.prova.titulo}
      </h2>
      <p class="celula celula-apoio">{t.prova.texto}</p>
    </Linha>
    <div class="vitrines-grade">
      {produtos.map((p) => (
        <Obra projeto={p} formato="grande" ficha="lado" />
      ))}
    </div>
    <Linha>
      <p class="solto">{t.prova.solto}</p>
    </Linha>
  </Secao>

  <Secao tom="branco" aria-labelledby="faq-titulo">
    <Linha>
      <h2 class="titulo-secao" id="faq-titulo">
        {t.faq.titulo}
      </h2>
    </Linha>
    {t.faq.itens.map((i) => (
      <Linha>
        <details class="faq-item">
          <summary>{i.pergunta}</summary>
          <p>{i.resposta}</p>
        </details>
      </Linha>
    ))}
  </Secao>

  <ChamadaFinal
    slot="fechamento"
    titulo={t.chamada.titulo}
    texto={t.chamada.texto}
    acao={t.chamada.acao}
    href={linkWhatsapp('sistema')}
    evento="whatsapp_chamada_final"
    secundaria={{ rotulo: t.chamada.formulario, href: rotas.contato }}
  />
</Base>
