---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Cabeca from '../../components/Cabeca.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';
import FontesPrevias from '../../components/FontesPrevias.astro';
import Icone from '../../components/Icone.astro';
import Secao from '../../components/Secao.astro';
import Vitrine from '../../components/Vitrine.astro';
import type { NomeIcone } from '../../data/icones';
import { todosProjetos, type Projeto } from '../../data/projetos';
import { linkWhatsapp } from '../../data/empresa';
import { rotaProjeto } from '../../i18n/rotas';
import { textos as t } from '../../i18n/textos';

export const getStaticPaths = (async () => {
  const projetos = await todosProjetos();
  return projetos.map((projeto) => ({ params: { slug: projeto.data.slug }, props: { projeto } }));
}) satisfies GetStaticPaths;

interface Props {
  projeto: Projeto;
}

/**
 * Página de projeto: a cabeça com a prévia grande na mesma faixa, e o case em cartões, uma parte
 * por título do Markdown (pedido do Igor, 05/11/2026: nada de texto corrido; ícones e cartões).
 * O Markdown do case é simples (títulos, parágrafos e listas), então é lido aqui mesmo.
 */
const { projeto } = Astro.props;
const d = projeto.data;

type Parte = { titulo: string; paragrafos: string[]; itens: string[] };
const partes: Parte[] = [];
for (const linha of (projeto.body ?? '').split('\n')) {
  const texto = linha.trim();
  if (!texto) continue;
  if (texto.startsWith('## ')) {
    partes.push({ titulo: texto.slice(3), paragrafos: [], itens: [] });
  } else if (texto.startsWith('- ')) {
    partes.at(-1)?.itens.push(texto.slice(2));
  } else {
    partes.at(-1)?.paragrafos.push(texto);
  }
}

// O ícone de cada parte, pelo que o título diz
const iconeDaParte = (titulo: string): NomeIcone => {
  const s = titulo.toLowerCase();
  if (s.includes('negócio') || s.includes('problema')) return 'etiqueta';
  if (s.includes('objetivo') || s.includes('para quem')) return 'alvo';
  if (s.includes('conceito') || s.includes('visual')) return 'olho';
  if (s.includes('faz')) return 'painel';
  if (s.includes('engenharia')) return 'escudo';
  return 'certo';
};

// O último projeto volta ao primeiro.
const todos = await todosProjetos();
const proximo = todos[(todos.findIndex((p) => p.id === projeto.id) + 1) % todos.length]!;
const assunto = d.tipo === 'site' ? 'site' : 'sistema';
const site = Astro.site!;
const imagem = `/og/${d.slug}.png`;

const jsonLd = {
  '@type': d.tipo === 'site' ? 'WebSite' : 'SoftwareApplication',
  '@id': new URL(rotaProjeto(d.slug), site).href + '#obra',
  name: d.titulo,
  description: d.resumo,
  ...(d.url ? { url: d.url } : {}),
  dateCreated: String(d.ano),
  inLanguage: 'pt-BR',
  creator: { '@id': `${site.origin}/#organizacao` },
  ...(d.tipo === 'produto'
    ? { applicationCategory: 'BusinessApplication', operatingSystem: 'Web' }
    : {}),
};
---

<Base titulo={d.titulo} descricao={d.resumo} imagem={imagem} jsonLd={[jsonLd]} semChamada>
  <FontesPrevias slot="head" />
  <article>
    <Cabeca titulo={d.titulo} texto={d.resumo}>
      <p class="cabeca-meta">
        <span>
          {t.projeto.rotulos.tipo}: {t.projeto.tipo[d.tipo]}
        </span>
        <span>
          {t.projeto.rotulos.ano}: {d.ano}
        </span>
        <span>
          {t.projeto.rotulos.status}: {t.projeto.status[d.status]}
        </span>
      </p>
      {d.url && (
        <a class="botao" href={d.url} target="_blank" rel="noopener noreferrer">
          {t.acoes.visitarSite}
          <span class="visualmente-oculto"> {t.linkExterno}</span>
        </a>
      )}
      <div slot="abaixo" class="obra-grande" aria-label={t.previa.rotulo(d.titulo, d.tipo)}>
        <Vitrine projeto={projeto} moldura="navegador" proporcao="16 / 10" ativa />
      </div>
    </Cabeca>

    <Secao tom="claro">
      <ul class="caso">
        {partes.map((parte) => (
          <li class="caso-parte revelar">
            <Icone nome={iconeDaParte(parte.titulo)} tamanho={28} />
            <h2>{parte.titulo}</h2>
            {parte.paragrafos.map((p) => (
              <p>{p}</p>
            ))}
            {parte.itens.length > 0 && (
              <ul>
                {parte.itens.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="vizinhos">
        <a class="vizinho" href={rotaProjeto(proximo.data.slug)}>
          <span class="vizinho-rotulo">{t.acoes.proximoProjeto}</span>
          <span class="vizinho-titulo">{proximo.data.titulo}</span>
        </a>
      </div>
    </Secao>
  </article>

  <ChamadaFinal
    slot="fechamento"
    titulo={
      d.tipo === 'site'
        ? 'Quer um site com a cara da sua empresa?'
        : 'Quer um sistema assim na sua empresa?'
    }
    acao={d.tipo === 'site' ? t.acoes.queroSite : t.acoes.queroSistema}
    href={linkWhatsapp(assunto)}
  />
</Base>
