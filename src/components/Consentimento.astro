---
import { rotas } from '../i18n/rotas';
import { privacidade as t } from '../i18n/paginas/privacidade';

/**
 * Rastreamento e banner de cookies. O ID do GA4 vem do .env (PUBLIC_GA4_ID); sem ele, não há
 * tag, não há cookie e o banner não existe. Com ele, o banner aparece até a pessoa escolher, e
 * nada é carregado antes disso (rastreamento.ts, consentimento.ts).
 * Persiste entre páginas (transition:persist), para a escolha não piscar na troca.
 */
const ga4 = (import.meta.env.PUBLIC_GA4_ID as string | undefined) || '';
---

{ga4 && (
  <div transition:persist="consentimento">
    <div data-rastreamento data-ga4={ga4} hidden></div>
    <section class="consentimento" aria-label={t.banner.rotulo} data-consentimento hidden>
      <p class="consentimento-texto">
        {t.banner.texto}{' '}
        <a class="link-fita" href={rotas.privacidade}>
          {t.banner.politica}
        </a>
        .
      </p>
      <fieldset class="consentimento-opcoes" data-consentimento-opcoes hidden>
        <legend>{t.banner.oQueAceita}</legend>
        <label class="consentimento-opcao">
          <input type="checkbox" checked disabled />
          {t.banner.essenciais}
        </label>
        <label class="consentimento-opcao">
          <input type="checkbox" name="analytics" />
          {t.banner.estatisticas}
        </label>
      </fieldset>
      <div class="consentimento-acoes">
        <button class="botao botao-contorno" type="button" data-acao="recusar">
          {t.banner.recusar}
        </button>
        <button class="botao botao-contorno" type="button" data-acao="personalizar">
          {t.banner.personalizar}
        </button>
        <button class="botao" type="button" data-acao="salvar" hidden>
          {t.banner.salvar}
        </button>
        <button class="botao" type="button" data-acao="aceitar">
          {t.banner.aceitar}
        </button>
      </div>
    </section>
    <script>
      import '../scripts/rastreamento';
      import '../scripts/consentimento';
    </script>
  </div>
)}
