---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabeca from '../../components/Cabeca.astro';
import Secao from '../../components/Secao.astro';
import {
  dataDoPost,
  dataIso,
  dataLonga,
  postsPublicados,
  tempoDeLeitura,
  type Post,
} from '../../data/blog';
import { rotaPost, rotas } from '../../i18n/rotas';
import { blog as t } from '../../i18n/paginas/blog';

export const getStaticPaths = (async () => {
  const posts = await postsPublicados();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, anterior: posts[i + 1] ?? null, proximo: posts[i - 1] ?? null },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  /** Mais antigo que este. */
  anterior: Post | null;
  /** Mais novo que este. */
  proximo: Post | null;
}

/** Um post: a capa na cabeça, o texto numa coluna clara, a chamada e os vizinhos. */
const { post, anterior, proximo } = Astro.props;
const { Content } = await render(post);
const data = dataDoPost(post);
const chamada = t.chamadas[post.data.chamada];
const destino = { sites: rotas.sites, sistemas: rotas.sistemas }[post.data.chamada];
const site = Astro.site!;

const jsonLd = {
  '@type': 'BlogPosting',
  '@id': new URL(rotaPost(post.id), site).href,
  headline: post.data.titulo,
  description: post.data.descricao,
  datePublished: dataIso(data),
  dateModified: dataIso(post.data.atualizadoEm ?? data),
  inLanguage: 'pt-BR',
  author: { '@type': 'Person', name: t.autor },
  publisher: { '@id': `${site.origin}/#organizacao` },
  image: new URL('/og.png', site).href,
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: new URL(rotaPost(post.id), site).href,
};
---

<Base titulo={post.data.titulo} descricao={post.data.descricao} jsonLd={[jsonLd]} tipoOg="article">
  <article>
    <Cabeca titulo={post.data.titulo} foto={post.data.capa}>
      <p class="cabeca-meta">
        <span>
          {t.rotulos.escritoPor} {t.autor}
        </span>
        <time datetime={dataIso(data)}>{dataLonga(data)}</time>
        <span>{t.rotulos.leitura(tempoDeLeitura(post))}</span>
        {post.data.atualizadoEm && (
          <span>
            {t.rotulos.atualizado}{' '}
            <time datetime={dataIso(post.data.atualizadoEm)}>
              {dataLonga(post.data.atualizadoEm)}
            </time>
          </span>
        )}
      </p>
    </Cabeca>

    <Secao tom="claro" miolo="miolo-centro">
      <div class="texto-longo">
        <p class="post-abertura">{post.data.descricao}</p>
        <Content />
      </div>
      <div class="post-chamada">
        <h2>{chamada.titulo}</h2>
        <p>{chamada.texto}</p>
        <a class="botao" href={destino} data-evento={`blog_${post.data.chamada}`}>
          {chamada.acao}
        </a>
      </div>
      <nav class="vizinhos" aria-label="Outros posts">
        {anterior && (
          <a class="vizinho" href={rotaPost(anterior.id)}>
            <span class="vizinho-rotulo">{t.rotulos.anterior}</span>
            <span class="vizinho-titulo">{anterior.data.titulo}</span>
          </a>
        )}
        {proximo && (
          <a class="vizinho vizinho-proximo" href={rotaPost(proximo.id)}>
            <span class="vizinho-rotulo">{t.rotulos.proximo}</span>
            <span class="vizinho-titulo">{proximo.data.titulo}</span>
          </a>
        )}
        <a class="link-fita" href={rotas.blog}>
          {t.rotulos.todos}
        </a>
      </nav>
    </Secao>
  </article>
</Base>
