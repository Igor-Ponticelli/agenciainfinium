---
import type { Projeto } from '../data/projetos';
import { rotaProjeto } from '../i18n/rotas';
import { textos as t } from '../i18n/textos';
import Ficha from './Ficha.astro';
import { previas } from './previas';

/**
 * Um projeto exposto fora da grade: a moldura com a prévia em HTML/CSS do site (ou do produto)
 * e a ficha nas células ao lado. A prévia é uma `region` com rótulo, fora de `<a>`, e só os
 * controles dela recebem o ponteiro; o resto da área leva à página do projeto. Ela é ativada
 * quando chega perto da tela (src/scripts/previas.ts).
 */
interface Props {
  projeto: Projeto;
  formato: 'grande' | 'media';
  /** Onde a ficha fica em telas largas. No celular, sempre embaixo. */
  ficha: 'lado' | 'abaixo';
  /** Na página do projeto a obra vem sozinha, com a ficha completa, e a prévia já nasce ativa. */
  completa?: boolean;
}

const { projeto, formato, ficha, completa = false } = Astro.props;
const d = projeto.data;
const idTitulo = `obra-${d.slug}`;
const Previa = previas[d.slug];

// O fundo e a cor de texto reais de cada projeto (.claude/docs/projetos/), que aparecem antes
// de a prévia ganhar fonte e script.
const cores: Record<string, { fundo: string; texto: string }> = {
  'brisa-cafe': { fundo: '#faf4e6', texto: '#2b1d14' },
  linetex: { fundo: '#ffffff', texto: '#0e1240' },
  lumaj: { fundo: '#474747', texto: '#ffffff' },
  retrodash: { fundo: '#0f1117', texto: '#ffffff' },
};
const cor = cores[d.slug] ?? { fundo: '#ffffff', texto: '#211f26' };
---

<article
  class="obra"
  data-formato={formato}
  data-ficha={ficha}
  aria-labelledby={completa ? undefined : idTitulo}
>
  <div
    class="obra-moldura"
    role="region"
    aria-label={t.previa.rotulo(d.titulo, d.tipo)}
    style={`--obra-fundo: ${cor.fundo}; --obra-texto: ${cor.texto}`}
  >
    {!completa && (
      <a class="obra-link" href={rotaProjeto(d.slug)} tabindex="-1" aria-hidden="true">
        {d.titulo}
      </a>
    )}
    {Previa ? (
      <div class="previa" data-previa={d.slug} data-ativa={completa ? '' : undefined}>
        <Previa />
      </div>
    ) : (
      <div class="obra-placeholder" aria-hidden="true">
        <strong>{d.titulo}</strong>
        <span>{t.previa.emPreparacao}</span>
      </div>
    )}
  </div>
  <Ficha projeto={projeto} completa={completa} idTitulo={idTitulo} />
</article>

<script>
  import '../scripts/previas';
</script>
