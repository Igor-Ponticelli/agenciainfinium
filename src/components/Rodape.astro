---
import logoWhite from '../assets/marca/logo-horizontal-white.svg';
import Glifo from './Glifo.astro';
import { cnpj, email, instagram, linkWhatsapp, nomeCompleto } from '../data/empresa';
import { rotas } from '../i18n/rotas';
import { privacidade } from '../i18n/paginas/privacidade';
import { textos as t } from '../i18n/textos';

/**
 * Rodapé no violeta mais profundo: logo branco pelo arquivo, a assinatura, três colunas de links
 * (serviços, empresa, contato) e a linha da empresa. Denso e útil, em texto pequeno.
 */
interface Props {
  /** Nas landing pages: só contato e privacidade, sem as colunas. */
  curto?: boolean;
}

const { curto = false } = Astro.props;
// [PENDENTE: o Igor decide se o CNPJ aparece no rodapé]
const mostrarCnpj = false;
const temRastreamento = Boolean(
  import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_META_PIXEL_ID,
);
const ano = new Date().getFullYear();
const altura = 24;
const largura = Math.round((altura * logoWhite.width) / logoWhite.height);
const colunas = [
  {
    titulo: 'Serviços',
    links: [
      { rotulo: t.menu.sites, href: rotas.sites },
      { rotulo: t.menu.sistemas, href: rotas.sistemas },
    ],
  },
  {
    titulo: 'Empresa',
    links: [
      { rotulo: t.menu.projetos, href: rotas.projetos },
      { rotulo: t.menu.blog, href: rotas.blog },
      { rotulo: t.menu.contato, href: rotas.contato },
      { rotulo: t.rodape.privacidade, href: rotas.privacidade },
    ],
  },
];
---

<footer class:list={['rodape', { 'rodape-curto': curto }]}>
  <div class="rodape-faixa">
    <div class="rodape-marca">
      <img
        src={logoWhite.src}
        width={largura}
        height={altura}
        alt={nomeCompleto}
        decoding="async"
      />
      <p>{t.rodape.assinatura}</p>
    </div>
    {!curto &&
      colunas.map((c) => (
        <div class="rodape-coluna">
          <p class="rodape-titulo">{c.titulo}</p>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.rotulo}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    <div class="rodape-coluna">
      <p class="rodape-titulo">Contato</p>
      <ul>
        <li>
          <a href={linkWhatsapp()} target="_blank" rel="noopener" data-evento="whatsapp_rodape">
            <Glifo nome="whatsapp" />
            {t.contato.whatsapp}
            <span class="visualmente-oculto">{t.linkExterno}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${email}`} data-evento="email_rodape">
            <Glifo nome="envelope" />
            {email}
          </a>
        </li>
        <li>
          <a href={instagram.url} target="_blank" rel="noopener">
            <Glifo nome="instagram" />
            {instagram.usuario}
            <span class="visualmente-oculto">{t.linkExterno}</span>
          </a>
        </li>
        {curto && (
          <li>
            <a href={rotas.privacidade}>{t.rodape.privacidade}</a>
          </li>
        )}
        {temRastreamento && (
          <li>
            <a href={rotas.privacidade} data-abrir-cookies>
              {privacidade.banner.reabrir}
            </a>
          </li>
        )}
      </ul>
    </div>
    <p class="rodape-empresa">
      <Glifo nome="copyright" tamanho={16} />
      {ano} {nomeCompleto}
      {mostrarCnpj && <span> · CNPJ {cnpj}</span>}
    </p>
  </div>
</footer>
