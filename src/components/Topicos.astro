---
import Icone from './Icone.astro';
import type { Topico } from '../i18n/paginas/inicio';

/**
 * Tópicos com ícone: a forma de dizer uma coisa por item, sem parágrafo. Cada tópico leva o
 * ícone desenhado pela fita conforme a rolagem, um título e, se houver, uma linha. `compactos`
 * é a lista em linha (ícone e texto lado a lado), para listas curtas como "todo site inclui".
 */
interface Props {
  itens: readonly Topico[];
  compactos?: boolean;
  as?: 'ul' | 'ol';
  class?: string;
}

const { itens, compactos = false, as: Tag = 'ul', class: classe } = Astro.props;
---

<Tag class:list={['topicos', { 'topicos-compactos': compactos }, classe]}>
  {itens.map((i) => (
    <li class="topico">
      <Icone nome={i.icone} tamanho={compactos ? 24 : 30} />
      <div class="topico-texto">
        <h3>{i.titulo}</h3>
        {i.texto && <p>{i.texto}</p>}
      </div>
    </li>
  ))}
</Tag>
