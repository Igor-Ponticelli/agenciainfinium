---
import simbolo from '../assets/marca/simbolo-lilac.svg';
import Base from '../layouts/Base.astro';
import Cabeca from '../components/Cabeca.astro';
import { rotas } from '../i18n/rotas';
import { metasPaginas, textos as t } from '../i18n/textos';

const meta = metasPaginas.naoEncontrada;
---

<Base titulo={meta.titulo} descricao={meta.descricao} noindex semChamada>
  <Cabeca titulo={t.naoEncontrada.titulo} texto={t.naoEncontrada.texto}>
    <img
      class="simbolo-404"
      src={simbolo.src}
      width={simbolo.width}
      height={simbolo.height}
      alt=""
      aria-hidden="true"
      decoding="async"
    />
    <div class="acoes">
      <a class="botao" href={rotas.inicio}>
        {t.naoEncontrada.voltar}
      </a>
    </div>
  </Cabeca>
</Base>
