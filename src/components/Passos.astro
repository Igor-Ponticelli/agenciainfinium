---
import Icone from './Icone.astro';
import type { Topico } from '../i18n/paginas/inicio';

/**
 * Como funciona: a cabeça fixa à esquerda e as etapas numeradas à direita, cada uma com o seu
 * ícone desenhado pela fita. A numeração é a ordem real. A fita percorre as etapas em laço
 * (fita.ts, `data-laco`) enquanto a lista está na tela; parada com movimento reduzido.
 */
interface Props {
  titulo: string;
  texto?: string;
  passos: readonly Topico[];
  idTitulo: string;
  /** Etapa que fica marcada em repouso. */
  inicio?: number;
}

const { titulo, texto, passos, idTitulo, inicio } = Astro.props;
const indice = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="passos-grade">
  <div class="passos-cabeca">
    <h2 id={idTitulo}>{titulo}</h2>
    {texto && <p>{texto}</p>}
    <slot />
  </div>
  <ol class="passos" data-laco data-laco-inicio={inicio}>
    {passos.map((p, i) => (
      <li class="passo">
        <span class="passo-numero" aria-hidden="true">
          {indice(i)}
        </span>
        <Icone nome={p.icone} tamanho={28} class="passo-icone" />
        <div class="passo-texto">
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
