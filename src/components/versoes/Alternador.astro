---
import { rotas } from '../../i18n/rotas';

/**
 * O alternador das versões de estudo: uma pílula fixa no canto inferior esquerdo para pular entre
 * o site atual e as três propostas sem voltar ao menu. Só existe nas páginas de estudo.
 */
interface Props {
  versao: 1 | 2 | 3;
}

const { versao } = Astro.props;
const opcoes = [
  { rotulo: 'Atual', href: rotas.inicio, numero: 0 },
  { rotulo: '1', href: '/site1/', numero: 1 },
  { rotulo: '2', href: '/site2/', numero: 2 },
  { rotulo: '3', href: '/site3/', numero: 3 },
];
---

<nav class="v-alternador" aria-label="Versões de estudo do site">
  <span class="v-alternador-rotulo">Versões</span>
  {opcoes.map((o) => (
    <a href={o.href} aria-current={o.numero === versao ? 'page' : undefined}>
      <span class="visualmente-oculto">Versão </span>
      {o.rotulo}
    </a>
  ))}
</nav>
