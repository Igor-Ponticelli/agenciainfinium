---
import Base from '../../layouts/Base.astro';
import Cabeca from '../../components/Cabeca.astro';
import { rotas } from '../../i18n/rotas';
import { metasPaginas, textos as t } from '../../i18n/textos';

/** Destino do formulário depois do envio por e-mail. Fora do sitemap e sem indexação. */
const meta = metasPaginas.contatoEnviado;
---

<Base titulo={meta.titulo} descricao={meta.descricao} noindex semChamada>
  <Cabeca titulo={t.enviado.titulo} texto={t.enviado.texto}>
    <div class="acoes">
      <a class="botao" href={rotas.inicio}>
        {t.enviado.voltar}
      </a>
    </div>
  </Cabeca>
</Base>
