---
import Base from '../layouts/Base.astro';
import Linha from '../components/Linha.astro';
import Secao from '../components/Secao.astro';
import { privacidade as t } from '../i18n/paginas/privacidade';
import { metasPaginas } from '../i18n/textos';

/** Política de privacidade (LGPD): o que este site coleta de verdade, em português simples. */
const meta = metasPaginas.privacidade;
const atualizado = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Sao_Paulo',
}).format(new Date(`${t.atualizadoEm}T12:00:00-03:00`));
---

<Base titulo={meta.titulo} descricao={meta.descricao}>
  <Secao cabeca folha="pagina-cabeca" aria-labelledby="pagina-titulo">
    <Linha>
      <h1 class="pagina-titulo" id="pagina-titulo">
        {t.titulo}
      </h1>
    </Linha>
    <Linha>
      <p class="pagina-texto">{t.texto}</p>
    </Linha>
    <Linha>
      <p class="post-cabeca">
        <span>
          {t.rotuloAtualizado}: <time datetime={t.atualizadoEm}>{atualizado}</time>
        </span>
      </p>
    </Linha>
  </Secao>

  <Secao tom="branco" aria-label={t.titulo}>
    {t.secoes.map((s) => (
      <Linha>
        <div class="projeto-texto">
          <h2>{s.titulo}</h2>
          {s.paragrafos.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </Linha>
    ))}
  </Secao>
</Base>
